# Writes a C++ source with the launcher fonts (resources/fonts/*.ttf) as byte
# arrays, so the app needs no extra bundle resources.
#
#   cod_embed_fonts(<output.cpp> <font files...>)

function(cod_embed_fonts output)
    set(arrays "")
    set(table "")
    set(count 0)
    foreach(font_path IN LISTS ARGN)
        get_filename_component(font_name "${font_path}" NAME)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${font_path}")
        file(READ "${font_path}" hex HEX)
        string(LENGTH "${hex}" hex_length)
        math(EXPR size "${hex_length} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(MAKE_C_IDENTIFIER "${font_name}" id)
        string(APPEND arrays "static const unsigned char k_${id}[] = {${bytes}};\n")
        string(APPEND table "    {\"${font_name}\", k_${id}, ${size}},\n")
        math(EXPR count "${count} + 1")
    endforeach()

    set(content "// Generated by cmake/embed_fonts.cmake - do not edit.\n")
    string(APPEND content "#include \"embedded_fonts.h\"\n\n#include <cstring>\n\nnamespace cod {\n\n")
    string(APPEND content "${arrays}\n")
    string(APPEND content "const EmbeddedFont kEmbeddedFonts[] = {\n${table}};\n")
    string(APPEND content "const int kEmbeddedFontCount = ${count};\n\n")
    string(APPEND content "const EmbeddedFont* FindEmbeddedFont(const char* name) {\n")
    string(APPEND content "  for (int i = 0; i < kEmbeddedFontCount; ++i) {\n")
    string(APPEND content "    if (std::strcmp(kEmbeddedFonts[i].name, name) == 0) {\n")
    string(APPEND content "      return &kEmbeddedFonts[i];\n")
    string(APPEND content "    }\n  }\n  return nullptr;\n}\n\n}  // namespace cod\n")

    # Only touch the file when it changes (no needless rebuilds).
    set(old_content "")
    if(EXISTS "${output}")
        file(READ "${output}" old_content)
    endif()
    if(NOT old_content STREQUAL content)
        file(WRITE "${output}" "${content}")
    endif()
endfunction()
