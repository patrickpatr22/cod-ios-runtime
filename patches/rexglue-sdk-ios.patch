+
+std::vector<ContentPackageFile> ContentManager::PackageFiles() {
+  std::lock_guard<std::mutex> lock(package_files_mutex_);
+  if (!package_files_scanned_) {
+    ScanPackageFolderLocked();
+  }
+  return package_files_;
+}
+
+void ContentManager::ScanPackageFolderLocked() {
+  package_files_scanned_ = true;
+  package_files_.clear();
+  std::error_code ec;
+  if (package_folder_.empty() || !std::filesystem::is_directory(package_folder_, ec)) {
+    return;
+  }
+  auto it = std::filesystem::recursive_directory_iterator(
+      package_folder_, std::filesystem::directory_options::skip_permission_denied, ec);
+  for (; !ec && it != std::filesystem::recursive_directory_iterator(); it.increment(ec)) {
+    std::error_code entry_ec;
+    if (!it->is_regular_file(entry_ec) ||
+        it->file_size(entry_ec) < sizeof(rex::filesystem::StfsHeader)) {
+      continue;
+    }
+    auto header = rex::filesystem::StfsContainerDevice::ReadPackageHeader(it->path());
+    if (!header) {
+      continue;
+    }
+    ContentPackageFile package_file;
+    package_file.path = it->path();
+    package_file.content_size = header->metadata.content_size;
+    package_file.license_mask = StfsLicenseMask(*header);
+    auto& data = package_file.data;
+    data.device_id = static_cast<uint32_t>(DummyDeviceId::HDD);
+    data.content_type = header->metadata.content_type;
+    data.title_id = header->metadata.execution_info.title_id;
+    data.xuid = 0;
+    data.set_file_name(rex::path_to_utf8(it->path().filename()));
+    auto display_name = header->metadata.display_name(rex::system::XLanguage::kEnglish);
+    data.set_display_name(display_name.empty() ? rex::path_to_utf16(it->path().filename())
+                                               : display_name);
+    const std::string file_name = data.file_name();
+    bool duplicate = false;
+    for (const auto& other : package_files_) {
+      duplicate = duplicate || (other.data.content_type == data.content_type &&
+                                rex::string::utf8_equal_case(other.data.file_name(), file_name));
+    }
+    if (duplicate) {
+      REXSYS_WARN("Content: {} is there twice, using the first", rex::path_to_utf8(it->path()));
+      continue;
+    }
+    REXSYS_INFO("Content: package {} ({}), type {:08X}, title {:08X}, {} MB, license {:08X}",
+                rex::path_to_utf8(it->path()), rex::string::to_utf8(display_name),
+                uint32_t(data.content_type.get()), uint32_t(data.title_id),
+                package_file.content_size / (1024 * 1024), package_file.license_mask);
+    package_files_.push_back(std::move(package_file));
+  }
+  std::stable_sort(package_files_.begin(), package_files_.end(),
+                   [](const ContentPackageFile& a, const ContentPackageFile& b) {
+                     return a.content_size > b.content_size;
+                   });
+}
+
+bool ContentManager::FindPackageFile(XContentType content_type, const std::string& file_name,
+                                     ContentPackageFile* out) {
+  std::lock_guard<std::mutex> lock(package_files_mutex_);
+  if (!package_files_scanned_) {
+    ScanPackageFolderLocked();
+  }
+  for (const auto& package_file : package_files_) {
+    if (package_file.data.content_type == content_type &&
+        rex::string::utf8_equal_case(package_file.data.file_name(), file_name)) {
+      *out = package_file;
+      return true;
+    }
+  }
+  return false;
+}
+
+bool ContentManager::IsPackageFilePath(const std::filesystem::path& path) {
+  std::lock_guard<std::mutex> lock(package_files_mutex_);
+  for (const auto& package_file : package_files_) {
+    if (package_file.path == path) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::filesystem::path ContentManager::MountTitleUpdate(uint32_t title_id, uint32_t media_id) {
+  // Title updates are made per disc version (media ID, STFS header 0x354);
+  // collections of them hold one per media ID. A package for the given media
+  // ID is preferred; without one the newest file name is taken (a title
+  // update often fits other discs with the same code, e.g. other regions).
+  auto package_media_id = [](const std::filesystem::path& path) -> uint32_t {
+    std::ifstream in(path, std::ios::binary);
+    uint8_t bytes[4] = {};
+    if (!in.seekg(0x354) || !in.read(reinterpret_cast<char*>(bytes), sizeof(bytes))) {
+      return 0;
+    }
+    return (uint32_t(bytes[0]) << 24) | (uint32_t(bytes[1]) << 16) | (uint32_t(bytes[2]) << 8) |
+           uint32_t(bytes[3]);
+  };
+  const ContentPackageFile* best = nullptr;
+  const ContentPackageFile* best_matching = nullptr;
+  auto package_files = PackageFiles();
+  for (const auto& package_file : package_files) {
+    if (package_file.data.content_type != XContentType::kInstaller ||
+        package_file.data.title_id != title_id) {
+      continue;
+    }
+    if (!best || package_file.path.filename() > best->path.filename()) {
+      best = &package_file;
+    }
+    if (media_id != 0) {
+      const uint32_t package_media = package_media_id(package_file.path);
+      REXSYS_INFO("Content: title update {} for media ID {:08X} (disc {:08X})",
+                  rex::path_to_utf8(package_file.path), package_media, media_id);
+      if (package_media == media_id &&
+          (!best_matching || package_file.path.filename() > best_matching->path.filename())) {
+        best_matching = &package_file;
+      }
+    }
+  }
+  if (best_matching) {
+    best = best_matching;
+  }
+  if (!best) {
+    return {};
+  }
+  constexpr const char* kMountPath = "\\Device\\TitleUpdate";
+  auto device = std::make_unique<rex::filesystem::StfsContainerDevice>(kMountPath, best->path);
+  if (!device->Initialize()) {
+    REXSYS_ERROR("Content: could not open title update {}", rex::path_to_utf8(best->path));
+    return {};
+  }
+  auto fs = kernel_state_->file_system();
+  fs->UnregisterSymbolicLink("update:");
+  fs->RegisterDevice(std::move(device));
+  fs->RegisterSymbolicLink("update:", kMountPath);
+  REXSYS_INFO("Content: title update {} mounted at update:", rex::path_to_utf8(best->path));
+  return best->path;
 }
 
