+namespace {
+// Performance counters, collected per guest frame in IssueSwap. The plain
+// ones are only touched on the command processor thread.
+double g_perf_fence_wait_ms = 0.0;
+uint32_t g_perf_draws = 0;
+uint32_t g_perf_render_passes = 0;
+uint32_t g_perf_submissions = 0;
+uint32_t g_perf_copies = 0;
+uint32_t g_perf_memexport_draws = 0;
+uint32_t g_perf_memexport_unknown = 0;
+// GPU execution time: a timestamp pair around every submission, read back
+// once the submission has completed. On Apple GPUs MoltenVK samples
+// timestamps at Metal encoder boundaries, so a tiny buffer fill right after
+// the first timestamp gives it an encoder to attach to.
+struct GpuTimer {
+  static constexpr uint32_t kSlots = 64;
+  bool initialized = false;
+  bool available = false;
+  VkQueryPool pool = VK_NULL_HANDLE;
+  VkBuffer fill_buffer = VK_NULL_HANDLE;
+  VkDeviceMemory fill_memory = VK_NULL_HANDLE;
+  PFN_vkCmdWriteTimestamp write_timestamp = nullptr;
+  PFN_vkGetQueryPoolResults get_results = nullptr;
+  PFN_vkCmdFillBuffer fill = nullptr;
+  double period_ns = 1.0;
+  std::deque<std::pair<uint64_t, uint32_t>> pending;  // submission, slot
+  uint32_t next_slot = 0;
+};
+GpuTimer g_gpu_timer;
+double g_perf_gpu_time_ms = 0.0;
+// Submissions up to this index are complete and their GPU times collected
+// (for the per-frame telemetry).
+uint64_t g_telemetry_gpu_collected = 0;
+
+// Detailed GPU time of one frame every few seconds: timestamps around every
+// render pass (sampled by MoltenVK at Metal encoder boundaries), summed per
+// kind of pass. Only the measured frame pays for the extra timestamps.
+struct GpuBreakdown {
+  static constexpr uint32_t kMaxQueries = 1024;
+  enum Category : uint8_t {
+    kScene,      // 2x MSAA with color (main scene)
+    kDepth,      // 2x MSAA depth only (prepass)
+    kShadow,     // 1x depth only (shadow maps)
+    kOther,      // 1x with color (post-processing, UI)
+    kTransfer,   // EDRAM ownership transfers and resolve clears
+    kResolve,    // render target dumps and resolve copies / clears (compute)
+    kTexLoad,    // texture untiling / conversion (compute)
+    kUpload,     // shared memory uploads (copies)
+    kCategoryCount,
+  };
+  static constexpr uint8_t kEndMark = 0xFF;
+  bool available = false;
+  bool armed = false;
+  bool reset_pending = false;
+  bool pending = false;
+  uint64_t arm_submission = 0;
+  uint64_t last_submission = 0;
+  uint32_t next_query = 0;
+  std::vector<std::pair<uint32_t, uint8_t>> marks;
+  std::chrono::steady_clock::time_point next_time = std::chrono::steady_clock::now() +
+                                                    std::chrono::seconds(20);
+  VkQueryPool pool = VK_NULL_HANDLE;
+  std::string text;
+  uint32_t frames_measured = 0;
+};
+GpuBreakdown g_gpu_breakdown;
+static_assert(GpuBreakdown::kTransfer == VulkanCommandProcessor::kGpuBreakdownTransfer &&
+              GpuBreakdown::kResolve == VulkanCommandProcessor::kGpuBreakdownResolve &&
+              GpuBreakdown::kTexLoad == VulkanCommandProcessor::kGpuBreakdownTexLoad &&
+              GpuBreakdown::kUpload == VulkanCommandProcessor::kGpuBreakdownUpload &&
+              GpuBreakdown::kEndMark == VulkanCommandProcessor::kGpuBreakdownEnd);
+// Guest render passes whose render area was tracked, and the sum of the
+// fractions of the framebuffer they covered (in 1/1000).
+uint32_t g_perf_render_area_passes = 0;
+uint64_t g_perf_render_area_permille = 0;
+
+// One-time capture of every draw and resolve of a single in-game frame
+// (written to the path in the BO2_FRAME_DUMP environment variable), to find
+// out which passes produce wrong output on the device.
+struct FrameDump {
+  uint32_t dumps_written = 0;
+  // Requested with gpu_frame_dump_request: every draw with all details.
+  uint32_t manual_written = 0;
+  bool manual = false;
+  bool active = false;
+  bool heavy = false;
+  std::chrono::steady_clock::time_point heavy_since;
+  uint32_t draw_index = 0;
+  uint32_t copy_index = 0;
+  std::string text;
+  std::vector<const Shader*> shaders;
+  std::unordered_set<uint64_t> shader_hashes;
+};
+FrameDump g_frame_dump;
+
+void FrameDumpAddShader(const Shader* shader) {
+  if (shader && g_frame_dump.shader_hashes.insert(shader->ucode_data_hash()).second) {
+    g_frame_dump.shaders.push_back(shader);
+  }
+}
