diff --git a/include/rex/ui/frame_pacing.h b/include/rex/ui/frame_pacing.h
new file mode 100644
index 0000000..68eba9b
--- /dev/null
+++ b/include/rex/ui/frame_pacing.h
@@ -0,0 +1,69 @@
+/**
+ * @file        ui/frame_pacing.h
+ * @brief       Guest frame pacing locked to the host display
+ *
+ * The title paces its frames with the guest vblank interrupt (it swaps on a
+ * vblank). Driven by a free-running timer, those vblanks drift against the
+ * real display, so frames reach the screen at uneven times and queue up in
+ * the swapchain. With pacing on, the guest vblanks fall on the display's own
+ * vsync grid (learned from the presentation timestamps), at 120 Hz or every
+ * other refresh (60 Hz), and at 60 Hz each frame is shown a fixed number of
+ * refreshes after its vblank, so every frame stays on screen equally long.
+ *
+ * Modes (cvar frame_pacing): 0 off, 1 automatic (120 Hz while the frames keep
+ * up, otherwise an even 60), 60 or 120 fixed.
+ *
+ * All times use rex::thread::MonotonicNowNs() (on Apple platforms the clock
+ * of Core Animation presentation times).
+ *
+ * @license     BSD 3-Clause License
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace rex::ui::pacing {
+
+// --- Display side (presenter) ---
+
+// Refresh period of the display in nanoseconds.
+void SetRefreshPeriodNs(uint64_t period_ns);
+uint64_t RefreshPeriodNs();
+// A presentation reached the display at actual_ns. desired_ns is the display
+// time that was requested for it (0 if it was shown as soon as possible).
+void OnPresentationDisplayed(uint64_t actual_ns, uint64_t desired_ns);
+
+// --- Guest vblank timer (GPU VSync thread) ---
+
+// Guest vblank rate in use: 0 if pacing is off, otherwise 60 or 120.
+uint32_t GuestFrameRate();
+// Time of the next guest vblank, on the display's vsync grid. 0 if pacing is
+// off (the caller keeps its own timer).
+uint64_t NextGuestVblankNs();
+// The guest vblank for the time returned by NextGuestVblankNs was signaled.
+void OnGuestVblank(uint64_t vblank_ns);
+
+// --- Guest swap (VdSwap) ---
+
+// Counts a guest swap and returns its index (1-based, wraps at 2^32), which
+// VdSwap passes along in the swap packet.
+uint32_t OnGuestSwap();
+
+// --- Command processor ---
+
+// Display time requested for the frame of this guest swap, 0 to show it as
+// soon as possible.
+uint64_t DesiredPresentNs(uint32_t swap_index);
+// A frame has finished on the GPU (for the automatic mode).
+void OnFrameFinished(double gpu_ms, double interval_ms);
+
+// --- Status ---
+
+// Short description for the overlay, e.g. "60 Hz (auto), +2".
+std::string StatusText();
