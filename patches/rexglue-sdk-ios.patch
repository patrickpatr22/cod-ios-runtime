+void TextureCache::Texture::StoreCpuContentHashes(
+    const std::unique_lock<std::recursive_mutex>& global_lock, bool loaded_base,
+    bool loaded_mips) {
+  if (!REXCVAR_GET(texture_cache_revalidate_unchanged)) {
+    base_content_hash_valid_ = false;
+    mips_content_hash_valid_ = false;
+    return;
+  }
+  SharedMemory& shared_memory = texture_cache().shared_memory();
+  const uint32_t size_limit = uint32_t(std::max(REXCVAR_GET(texture_cache_revalidate_size_limit), 0));
+  if (loaded_base) {
+    uint32_t address = key().base_page << 12;
+    uint32_t length = GetHashedGuestRangeLength(address, GetGuestBaseSize());
+    // Only hash bytes that are exactly what was just uploaded and loaded:
+    // still valid (no CPU write since the upload) and not GPU-written.
+    base_content_hash_valid_ = length != 0 && length <= size_limit &&
+                               shared_memory.IsRangeValidLocked(address, length) &&
+                               !shared_memory.IsRangeGpuWrittenLocked(address, length);
+    if (base_content_hash_valid_) {
+      base_content_hash_ =
+          XXH3_64bits(shared_memory.guest_memory().TranslatePhysical(address), length);
+    }
+  }
+  if (loaded_mips) {
+    uint32_t address = key().mip_page << 12;
+    uint32_t length = GetHashedGuestRangeLength(address, GetGuestMipsSize());
+    mips_content_hash_valid_ = length != 0 && length <= size_limit &&
+                               shared_memory.IsRangeValidLocked(address, length) &&
+                               !shared_memory.IsRangeGpuWrittenLocked(address, length);
+    if (mips_content_hash_valid_) {
+      mips_content_hash_ =
+          XXH3_64bits(shared_memory.guest_memory().TranslatePhysical(address), length);
+    }
+  }
+}
+
+void TextureCache::Texture::StoreAuditHashes(
+    const std::unique_lock<std::recursive_mutex>& global_lock, bool loaded_base,
+    bool loaded_mips) {
+  if (!REXCVAR_GET(texture_audit)) {
+    audit_base_valid_ = false;
+    audit_mips_valid_ = false;
+    return;
+  }
+  SharedMemory& shared_memory = texture_cache().shared_memory();
+  constexpr uint32_t kAuditSizeLimit = 8 * 1024 * 1024;
+  auto hash_part = [&](uint32_t address, uint32_t size, uint64_t& hash_out) {
+    const uint32_t length = GetHashedGuestRangeLength(address, size);
+    if (!length || length > kAuditSizeLimit || !shared_memory.IsRangeValidLocked(address, length) ||
+        shared_memory.IsRangeGpuWrittenLocked(address, length)) {
+      return false;
+    }
+    hash_out = XXH3_64bits(shared_memory.guest_memory().TranslatePhysical(address), length);
+    return true;
+  };
+  if (loaded_base) {
+    audit_base_valid_ = hash_part(key().base_page << 12, GetGuestBaseSize(), audit_base_hash_);
+  }
+  if (loaded_mips) {
+    audit_mips_valid_ = hash_part(key().mip_page << 12, GetGuestMipsSize(), audit_mips_hash_);
+  }
+}
