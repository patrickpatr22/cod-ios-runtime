+void TextureCache::AuditTextures(uint32_t byte_budget) {
+  if (!REXCVAR_GET(texture_audit)) {
+    return;
+  }
+  auto global_lock = global_critical_region_.Acquire();
+  // Each texture at most every ~2 s (120 frames), most recently used first.
+  constexpr uint64_t kIntervalSubmissions = 120;
+  uint32_t hashed_bytes = 0;
+  uint32_t visited = 0;
+  for (Texture* texture = texture_used_last_; texture && visited < 1024;
+       texture = texture->used_previous()) {
+    ++visited;
+    if (texture->last_usage_submission_index() + 2 < current_submission_index_) {
+      // Not used recently - neither is anything before it in the LRU list.
+      break;
+    }
+    hashed_bytes += texture->AuditIfDue(global_lock, current_submission_index_, kIntervalSubmissions);
+    if (hashed_bytes >= byte_budget) {
+      break;
+    }
+  }
+}
