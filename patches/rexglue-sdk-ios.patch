+namespace {
+// The load paths request validity for and read the 16-byte-aligned extent, so
+// hash exactly those bytes.
+uint32_t GetHashedGuestRangeLength(uint32_t guest_address, uint32_t guest_size) {
+  return std::min(rex::align(guest_size, UINT32_C(16)),
+                  SharedMemory::kBufferSize - std::min(guest_address, SharedMemory::kBufferSize));
+}
