+void ContentManager::SetPackageFolder(const std::filesystem::path& folder) {
+  std::lock_guard<std::mutex> lock(package_files_mutex_);
+  package_folder_ = folder;
+  package_files_scanned_ = false;
+  package_files_.clear();
