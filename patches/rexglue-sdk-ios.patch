diff --git a/include/rex/ui/present_timing.h b/include/rex/ui/present_timing.h
new file mode 100644
index 0000000..ba65ed6
--- /dev/null
+++ b/include/rex/ui/present_timing.h
@@ -0,0 +1,63 @@
+/**
+ * @file        ui/present_timing.h
+ * @brief       Presentation timing records for the performance telemetry
+ *
+ * The presenter tags every host presentation with the guest frame it shows
+ * and, where the driver reports it (VK_GOOGLE_display_timing), when it
+ * actually reached the display. The GPU telemetry drains these records to
+ * compute the frame rate that is really shown and the spacing of the frames.
+ *
+ * @license     BSD 3-Clause License
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace rex::ui {
+
+struct PresentTimingRecord {
+  // Guest frame number (Presenter::SetNextGuestOutputFrameId), 0 if none.
+  uint64_t frame_id = 0;
+  // How many times this guest frame had been presented before (repaints for
+  // the UI only).
+  uint32_t repaint = 0;
+  // rex::thread::MonotonicNowNs() when vkQueuePresentKHR was called.
+  uint64_t present_call_ns = 0;
+  // From the driver, same clock: when the image was shown (0 if it never was,
+  // or if the driver doesn't report it - then has_display_time is false).
+  bool has_display_time = false;
+  uint64_t actual_present_ns = 0;
+};
+
+// Called by the presenter (UI thread) for every presentation, and again with
+// has_display_time once the driver reports the display time.
+void PushPresentTiming(const PresentTimingRecord& record);
+// Moves the queued records into `out` (appends); returns how many.
+size_t DrainPresentTiming(std::vector<PresentTimingRecord>& out);
+// UI thread painting (presentation of each frame): totals since start.
+struct PaintTimingTotals {
+  uint64_t count = 0;
+  uint64_t total_ns = 0;       // whole paint and present
+  uint64_t acquire_ns = 0;     // vkAcquireNextImageKHR
+  uint64_t await_ns = 0;       // waiting for an earlier paint submission
+  uint64_t consume_ns = 0;     // taking the newest guest output image
+  uint64_t ui_ns = 0;          // UI drawers (ImGui)
+  uint64_t queue_lock_ns = 0;  // waiting for the Vulkan queue (shared with the GPU emulation)
+  uint64_t submit_ns = 0;      // vkQueueSubmit calls
+  uint64_t present_ns = 0;     // vkQueuePresentKHR
+  uint64_t cpu_ns = 0;         // CPU time of the painting thread during the paints
+  uint64_t paced = 0;          // presentations with a requested display time
+  uint64_t max_total_ns = 0;
+};
+// Adds one paint (count and max_total_ns of `sample` are ignored).
+void AddPaintTiming(const PaintTimingTotals& sample);
+PaintTimingTotals ReadPaintTiming();
+
+// Display refresh interval reported by the driver in nanoseconds (0 unknown).
+uint64_t DisplayRefreshDurationNs();
+void SetDisplayRefreshDurationNs(uint64_t duration_ns);
+
+}  // namespace rex::ui
