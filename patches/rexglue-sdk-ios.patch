+// Automatic in-game comparison of runtime settings (perf_ab_test): once full
+// scenes have been rendered for a while, every configuration is applied in
+// turn for a few seconds (in several rounds, so scene changes average out),
+// and the frames after a short warm-up are measured. The result table stays
+// in the overlay and goes to the log.
+class AbTest {
+ public:
+  // Called once per guest frame on the command processor thread. Returns the
+  // status text for the overlay (empty if no comparison is configured).
+  const std::string& OnFrame(const PerfWindow& frame, bool heavy) {
+    const std::string spec = REXCVAR_GET(perf_ab_test);
+    if (spec != spec_) {
+      spec_ = spec;
+      Parse();
+    }
+    if (configs_.empty()) {
+      status_.clear();
+      telemetry::SetAbPhase(std::string(), false);
+      return status_;
+    }
+    const double frame_seconds = frame.worst_frame_ms / 1000.0;
+    if (state_ != State::kRunning) {
+      telemetry::SetAbPhase(std::string(), false);
+    }
+    switch (state_) {
+      case State::kWaiting: {
+        // Single lighter frames (looking at the sky) don't restart the wait,
+        // only a few seconds of them (menu, loading screen) do.
+        if (heavy) {
+          heavy_seconds_ += frame_seconds;
+          light_seconds_ = 0.0;
+        } else {
+          light_seconds_ += frame_seconds;
+          if (light_seconds_ >= 3.0) {
+            heavy_seconds_ = 0.0;
+          }
+        }
+        const double start_seconds = std::max(REXCVAR_GET(perf_ab_start_seconds), 0);
+        if (heavy_seconds_ >= start_seconds) {
+          Start();
+        } else {
+          status_ = fmt::format("Vergleichstest ({} Konfigurationen) startet nach {:.0f} s im "
+                                "Spiel: {:.0f} s",
+                                configs_.size(), start_seconds, heavy_seconds_);
+        }
+      } break;
+      case State::kRunning: {
+        if (!heavy) {
+          // Menus, loading or the scoreboard - neither measured nor counted.
+          break;
+        }
+        AbConfig& config = configs_[phase_ % configs_.size()];
+        phase_seconds_ += frame_seconds;
+        const bool measuring = phase_seconds_ > std::max(REXCVAR_GET(perf_ab_warmup_seconds), 0);
+        telemetry::SetAbPhase(config.label, measuring);
+        if (measuring) {
+          config.measured.Add(frame);
+          config.measured_seconds += frame_seconds;
+        }
+        const double phase_length = std::max(REXCVAR_GET(perf_ab_phase_seconds), 3);
+        if (phase_seconds_ >= phase_length) {
+          REXGPU_WARN("Vergleichstest Phase {}/{}: {} | {}", phase_ + 1, PhaseCount(),
+                      config.label, Summary(config));
+          ++phase_;
+          if (phase_ >= PhaseCount()) {
+            Finish();
+            break;
+          }
+          Apply(phase_ % configs_.size());
+          phase_seconds_ = 0.0;
+        }
+        const AbConfig& current = configs_[phase_ % configs_.size()];
+        status_ = fmt::format("Vergleichstest {}/{}: {} - noch {:.0f} s", phase_ + 1,
+                              PhaseCount(), current.label,
+                              std::max(phase_length - phase_seconds_, 0.0));
+      } break;
+      default:
+        break;
+    }
+    return status_;
+  }
+
+ private:
+  struct AbConfig {
+    std::string label;
+    std::string description;
+    std::vector<std::pair<std::string, std::string>> overrides;
+    PerfWindow measured;
+    double measured_seconds = 0.0;
+  };
+  enum class State { kWaiting, kRunning, kDone };
+
+  static std::string Trim(std::string_view text) {
+    size_t begin = text.find_first_not_of(" \t");
+    if (begin == std::string_view::npos) {
+      return {};
+    }
+    size_t end = text.find_last_not_of(" \t");
+    return std::string(text.substr(begin, end - begin + 1));
+  }
+
+  static std::vector<std::string> Split(std::string_view text, char separator) {
+    std::vector<std::string> parts;
+    size_t start = 0;
+    while (start <= text.size()) {
+      size_t end = text.find(separator, start);
+      if (end == std::string_view::npos) {
+        end = text.size();
+      }
+      std::string part = Trim(text.substr(start, end - start));
+      if (!part.empty()) {
+        parts.push_back(std::move(part));
+      }
+      start = end + 1;
+    }
+    return parts;
+  }
+
+  void Parse() {
+    if (state_ == State::kRunning) {
+      Restore();
+    }
+    configs_.clear();
+    base_values_.clear();
+    state_ = State::kWaiting;
+    heavy_seconds_ = 0.0;
+    light_seconds_ = 0.0;
+    phase_ = 0;
+    phase_seconds_ = 0.0;
+    for (const std::string& config_text : Split(spec_, ';')) {
+      AbConfig& config = configs_.emplace_back();
+      const size_t colon = config_text.find(':');
+      config.label = Trim(std::string_view(config_text).substr(0, colon));
+      if (colon != std::string::npos) {
+        for (const std::string& assignment :
+             Split(std::string_view(config_text).substr(colon + 1), ',')) {
+          const size_t equals = assignment.find('=');
+          if (equals == std::string::npos) {
+            continue;
+          }
+          config.overrides.emplace_back(Trim(std::string_view(assignment).substr(0, equals)),
+                                        Trim(std::string_view(assignment).substr(equals + 1)));
+        }
+      }
+      for (const auto& [name, value] : config.overrides) {
+        if (!config.description.empty()) {
+          config.description += ", ";
+        }
+        config.description += name + "=" + value;
+      }
+      if (config.description.empty()) {
+        config.description = "Basis";
+      }
+    }
+  }
+
+  uint32_t PhaseCount() const {
+    return uint32_t(configs_.size()) * uint32_t(std::max(REXCVAR_GET(perf_ab_rounds), 1));
+  }
+
+  void Start() {
+    // Remember the values every configuration starts from.
+    base_values_.clear();
+    for (const AbConfig& config : configs_) {
+      for (const auto& override_value : config.overrides) {
+        const std::string& name = override_value.first;
+        if (std::none_of(base_values_.begin(), base_values_.end(),
+                         [&](const auto& base) { return base.first == name; })) {
+          base_values_.emplace_back(name, rex::cvar::GetFlagByName(name));
+        }
+      }
+    }
+    state_ = State::kRunning;
+    phase_ = 0;
+    phase_seconds_ = 0.0;
+    Apply(0);
+    REXGPU_WARN("Vergleichstest gestartet: {}", spec_);
+  }
+
+  void Restore() {
+    for (const auto& [name, value] : base_values_) {
+      rex::cvar::SetFlagByName(name, value);
+    }
+  }
+
+  void Apply(size_t config_index) {
+    Restore();
+    for (const auto& [name, value] : configs_[config_index].overrides) {
+      if (!rex::cvar::SetFlagByName(name, value)) {
+        REXGPU_WARN("Vergleichstest: {}={} konnte nicht gesetzt werden", name, value);
+      }
+    }
+  }
+
+  static std::string Summary(const AbConfig& config) {
+    const PerfWindow& m = config.measured;
+    const double frames = std::max(double(m.swaps), 1.0);
+    const double seconds = std::max(config.measured_seconds, 0.001);
+    return fmt::format(
+        "{:.1f} FPS | {:.1f} ms | GPU {:.1f} ms | GPU-Wait {:.0f}% | Passes {:.0f} (Upload "
+        "{:.0f}, TexLoad {:.0f}) | Uploads {:.0f} (vorgezogen {:.0f}, nur Vertex-Bereich {:.0f}) | "
+        "Flaeche {:.0f}% | Submits {:.1f} | Haenger {} | max {:.0f} ms",
+        m.swaps / seconds, 1000.0 * seconds / frames, m.gpu_time_ms / frames,
+        m.fence_wait_ms / (10.0 * seconds),
+        m.render_passes / frames, m.upload_breaks / frames, m.texture_load_breaks / frames,
+        m.uploads / frames, m.uploads_hoisted / frames, m.upload_breaks_declared / frames,
+        m.AreaPercent(), m.submissions / frames, m.hitches, m.worst_frame_ms);
+  }
+
+  void Finish() {
+    state_ = State::kDone;
+    Apply(0);
+    double seconds_each = 0.0;
+    for (const AbConfig& config : configs_) {
+      seconds_each = std::max(seconds_each, config.measured_seconds);
+    }
+    status_ = fmt::format("Vergleichstest fertig (je ca. {:.0f} s gemessen, jetzt wieder {}):",
+                          seconds_each, configs_[0].label);
+    std::string report = fmt::format(
+        "Vergleichstest ({} Konfigurationen, je ca. {:.0f} s gemessen)\n\n", configs_.size(),
+        seconds_each);
+    for (const AbConfig& config : configs_) {
+      status_ += fmt::format("\n{}: {}", config.label, Summary(config));
+      REXGPU_WARN("Vergleichstest Ergebnis {} ({}): {}", config.label, config.description,
+                  Summary(config));
+      report += fmt::format("{} ({}): {}\n", config.label, config.description, Summary(config));
+    }
+    const std::string telemetry_report = telemetry::AbReport();
+    if (!telemetry_report.empty()) {
+      report += "\nPro Bild (Telemetrie):\n" + telemetry_report;
+      std::string log_text = telemetry_report;
+      std::replace(log_text.begin(), log_text.end(), '\n', ' ');
+      REXGPU_WARN("Vergleichstest Telemetrie: {}", log_text);
+    }
+    const std::string report_path = REXCVAR_GET(perf_report_path);
+    if (!report_path.empty()) {
+      if (FILE* file = std::fopen(report_path.c_str(), "w")) {
+        std::fwrite(report.data(), 1, report.size(), file);
+        std::fclose(file);
+      }
+    }
+  }
+
+  std::string spec_;
+  std::vector<AbConfig> configs_;
+  std::vector<std::pair<std::string, std::string>> base_values_;
+  State state_ = State::kWaiting;
+  double heavy_seconds_ = 0.0;
+  double light_seconds_ = 0.0;
+  uint32_t phase_ = 0;
+  double phase_seconds_ = 0.0;
+  std::string status_;
+};
+AbTest g_ab_test;
+
+std::mutex g_perf_summary_mutex;
+std::string g_perf_summary;
+}  // namespace
+
+// Bumped from the pipeline creation threads, the texture cache and the
+// shared memory.
+std::atomic<uint32_t> g_perf_pipelines_created{0};
+std::atomic<uint32_t> g_perf_texture_loads{0};
+std::atomic<uint32_t> g_perf_texture_load_breaks{0};
+std::atomic<uint32_t> g_perf_uploads{0};
+std::atomic<uint32_t> g_perf_upload_breaks{0};
+// Uploads moved to the start of the submission instead of interrupting a
+// render pass.
+std::atomic<uint32_t> g_perf_uploads_hoisted{0};
+std::atomic<uint32_t> g_perf_upload_breaks_declared{0};
+std::atomic<uint64_t> g_perf_upload_bytes{0};
+
+// Latest one-second summary for on-screen diagnostics in the host app, which
+// finds this function with dlsym(RTLD_DEFAULT, ...).
+extern std::atomic<uint32_t> g_storage_load_phase;
+extern std::atomic<uint32_t> g_storage_load_done;
+extern std::atomic<uint32_t> g_storage_load_total;
+
+extern "C" REX_GPU_PLUGIN_EXPORT size_t rexgpu_perf_summary(char* out, size_t out_size) {
+  std::lock_guard<std::mutex> lock(g_perf_summary_mutex);
+  std::string loading;
+  if (const uint32_t phase = g_storage_load_phase.load(std::memory_order_acquire)) {
+    loading = fmt::format(
+        "{}: {} von {}\nNach einem Update oder Treiberwechsel dauert das einmalig laenger.",
+        phase == 1 ? "Shader werden uebersetzt" : "Grafik-Pipelines werden vorbereitet",
+        g_storage_load_done.load(std::memory_order_relaxed),
+        g_storage_load_total.load(std::memory_order_relaxed));
+  }
+  const std::string& text = loading.empty() ? g_perf_summary : loading;
+  if (!out || !out_size) {
+    return text.size();
+  }
+  const size_t length = std::min(text.size(), out_size - 1);
+  std::memcpy(out, text.data(), length);
+  out[length] = '\0';
+  return length;
+}
+
+uint32_t VulkanCommandProcessor::BeginGpuTimer(VkCommandBuffer command_buffer) {
+  GpuTimer& timer = g_gpu_timer;
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (!timer.initialized) {
+    timer.initialized = true;
+    const auto& ifn = vulkan_device->vulkan_instance()->functions();
+    timer.write_timestamp = reinterpret_cast<PFN_vkCmdWriteTimestamp>(
+        ifn.vkGetDeviceProcAddr(device, "vkCmdWriteTimestamp"));
+    timer.get_results = reinterpret_cast<PFN_vkGetQueryPoolResults>(
+        ifn.vkGetDeviceProcAddr(device, "vkGetQueryPoolResults"));
+    timer.fill =
+        reinterpret_cast<PFN_vkCmdFillBuffer>(ifn.vkGetDeviceProcAddr(device, "vkCmdFillBuffer"));
+    VkPhysicalDeviceProperties physical_device_properties;
+    ifn.vkGetPhysicalDeviceProperties(vulkan_device->physical_device(),
+                                      &physical_device_properties);
+    timer.period_ns = physical_device_properties.limits.timestampPeriod;
+    VkQueryPoolCreateInfo query_pool_create_info = {};
+    query_pool_create_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+    query_pool_create_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    query_pool_create_info.queryCount = GpuTimer::kSlots * 2;
+    DeferredCommandBuffer::write_timestamp_function = timer.write_timestamp;
+    if (timer.write_timestamp && timer.get_results && timer.fill &&
+        physical_device_properties.limits.timestampComputeAndGraphics &&
+        dfn.vkCreateQueryPool(device, &query_pool_create_info, nullptr, &timer.pool) ==
+            VK_SUCCESS &&
+        ui::vulkan::util::CreateDedicatedAllocationBuffer(
+            vulkan_device, 256, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+            ui::vulkan::util::MemoryPurpose::kDeviceLocal, timer.fill_buffer, timer.fill_memory)) {
+      timer.available = true;
+      query_pool_create_info.queryCount = GpuBreakdown::kMaxQueries;
+      g_gpu_breakdown.available = dfn.vkCreateQueryPool(device, &query_pool_create_info, nullptr,
+                                                        &g_gpu_breakdown.pool) == VK_SUCCESS;
+    } else {
+      REXGPU_WARN("GPU-Zeitmessung nicht verfuegbar");
+    }
+  }
+  if (g_gpu_breakdown.reset_pending &&
+      GetCurrentSubmission() > g_gpu_breakdown.arm_submission) {
+    // Before the timestamps of the measured frame (recorded in the deferred
+    // command buffer, executed after this).
+    dfn.vkCmdResetQueryPool(command_buffer, g_gpu_breakdown.pool, 0,
+                            GpuBreakdown::kMaxQueries);
+    g_gpu_breakdown.reset_pending = false;
+  }
+  if (!timer.available || timer.pending.size() >= GpuTimer::kSlots) {
+    return UINT32_MAX;
+  }
+  const uint32_t slot = timer.next_slot;
+  timer.next_slot = (timer.next_slot + 1) % GpuTimer::kSlots;
+  dfn.vkCmdResetQueryPool(command_buffer, timer.pool, slot * 2, 2);
+  timer.write_timestamp(command_buffer, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, timer.pool, slot * 2);
+  timer.fill(command_buffer, timer.fill_buffer, 0, 4, 0);
+  timer.pending.emplace_back(GetCurrentSubmission(), slot);
+  return slot;
+}
+
+void VulkanCommandProcessor::EndGpuTimer(VkCommandBuffer command_buffer, uint32_t slot) {
+  if (slot == UINT32_MAX) {
+    return;
+  }
+  g_gpu_timer.write_timestamp(command_buffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                              g_gpu_timer.pool, slot * 2 + 1);
+}
+
+void VulkanCommandProcessor::MarkGpuBreakdown(uint8_t category) {
+  GpuBreakdown& breakdown = g_gpu_breakdown;
+  if (!breakdown.armed || GetCurrentSubmission() <= breakdown.arm_submission ||
+      breakdown.next_query >= GpuBreakdown::kMaxQueries) {
+    return;
+  }
+  const uint32_t query = breakdown.next_query++;
+  deferred_command_buffer_.CmdVkWriteTimestamp(category == GpuBreakdown::kEndMark
+                                                   ? VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT
+                                                   : VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                                               breakdown.pool, query);
+  breakdown.marks.emplace_back(query, category);
+}
+
+void VulkanCommandProcessor::UpdateGpuBreakdown() {
+  GpuBreakdown& breakdown = g_gpu_breakdown;
+  if (!breakdown.available) {
+    return;
+  }
+  const auto now = std::chrono::steady_clock::now();
+  if (breakdown.armed) {
+    // The measured frame ends here.
+    breakdown.armed = false;
+    breakdown.pending = true;
+    breakdown.last_submission = GetCurrentSubmission();
+    return;
+  }
+  if (breakdown.pending) {
+    if (GetCompletedSubmission() < breakdown.last_submission || breakdown.reset_pending) {
+      return;
+    }
+    breakdown.pending = false;
+    breakdown.next_time = now + std::chrono::seconds(std::max(REXCVAR_GET(perf_gpu_breakdown_seconds), 1));
+    if (breakdown.marks.empty()) {
+      return;
+    }
+    std::vector<uint64_t> timestamps(breakdown.next_query);
+    if (g_gpu_timer.get_results(GetVulkanDevice()->device(), breakdown.pool, 0,
+                                breakdown.next_query, timestamps.size() * sizeof(uint64_t),
+                                timestamps.data(), sizeof(uint64_t),
+                                VK_QUERY_RESULT_64_BIT) != VK_SUCCESS) {
+      return;
+    }
+    double category_ms[GpuBreakdown::kCategoryCount] = {};
+    uint32_t category_passes[GpuBreakdown::kCategoryCount] = {};
+    double between_ms = 0.0;
+    uint64_t pass_begin = 0, last_end = 0;
+    uint8_t pass_category = GpuBreakdown::kEndMark;
+    for (const auto& [query, category] : breakdown.marks) {
+      const uint64_t t = timestamps[query];
+      if (category != GpuBreakdown::kEndMark) {
+        if (last_end && t > last_end) {
+          between_ms += double(t - last_end) * g_gpu_timer.period_ns * 1e-6;
+        }
+        pass_begin = t;
+        pass_category = category;
+      } else if (pass_category != GpuBreakdown::kEndMark) {
+        if (t > pass_begin) {
+          category_ms[pass_category] += double(t - pass_begin) * g_gpu_timer.period_ns * 1e-6;
+        }
+        ++category_passes[pass_category];
+        pass_category = GpuBreakdown::kEndMark;
+        last_end = t;
+      }
+    }
+    static const char* const kNames[GpuBreakdown::kCategoryCount] = {
+        "Szene", "Tiefe", "Schatten", "Post/UI", "Transfer", "Resolve", "Tex-Laden", "Upload"};
+    std::string text = "GPU-Aufteilung (1 Bild):";
+    for (uint32_t i = 0; i < GpuBreakdown::kCategoryCount; ++i) {
+      text += fmt::format(" {} {:.1f} ms ({})", kNames[i], category_ms[i], category_passes[i]);
+      if (i + 1 < GpuBreakdown::kCategoryCount) {
+        text += ",";
+      }
+    }
+    text += fmt::format(", dazwischen {:.1f} ms", between_ms);
+    REXGPU_WARN("{}", text);
+    breakdown.text = std::move(text);
+    breakdown.marks.clear();
+    return;
+  }
+  const int32_t breakdown_limit = REXCVAR_GET(perf_gpu_breakdown_count);
+  if (now >= breakdown.next_time && REXCVAR_GET(perf_gpu_breakdown_seconds) > 0 &&
+      (breakdown_limit <= 0 || breakdown.frames_measured < uint32_t(breakdown_limit))) {
+    ++breakdown.frames_measured;
+    breakdown.armed = true;
+    breakdown.reset_pending = true;
+    breakdown.arm_submission = GetCurrentSubmission();
+    breakdown.next_query = 0;
+    breakdown.marks.clear();
+  }
+}
+
+void VulkanCommandProcessor::CollectGpuTime() {
+  GpuTimer& timer = g_gpu_timer;
+  if (!timer.available) {
+    g_telemetry_gpu_collected = GetCompletedSubmission();
+    return;
+  }
+  const VkDevice device = GetVulkanDevice()->device();
+  const uint64_t completed = GetCompletedSubmission();
+  while (!timer.pending.empty() && timer.pending.front().first <= completed) {
+    uint64_t timestamps[2] = {};
+    VkResult result =
+        timer.get_results(device, timer.pool, timer.pending.front().second * 2, 2,
+                          sizeof(timestamps), timestamps, sizeof(uint64_t), VK_QUERY_RESULT_64_BIT);
+    if (result == VK_NOT_READY) {
+      break;
+    }
+    if (result == VK_SUCCESS && timestamps[1] > timestamps[0]) {
+      const double ms = double(timestamps[1] - timestamps[0]) * timer.period_ns * 1e-6;
+      if (ms < 1000.0) {
+        g_perf_gpu_time_ms += ms;
+        telemetry::OnSubmissionGpuTime(timer.pending.front().first, ms);
+      }
+    }
+    timer.pending.pop_front();
+  }
+  g_telemetry_gpu_collected =
+      timer.pending.empty() ? completed : std::min(completed, timer.pending.front().first - 1);
+}
