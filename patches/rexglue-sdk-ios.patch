+class CsvWriter {
+ public:
+  ~CsvWriter() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      stop_ = true;
+    }
+    cv_.notify_all();
+    if (thread_.joinable()) {
+      thread_.join();
+    }
+  }
+
+  // Appends text to file `slot` (0 frames, 1 display); opens it with the
+  // header when the path changes. Empty path = off.
+  void Append(int slot, const std::string& path, const char* header, std::string&& text) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    Slot& s = slots_[slot];
+    if (path != s.path) {
+      s.path = path;
+      s.reopen = true;
+      s.header = header;
+    }
+    if (s.path.empty()) {
+      return;
+    }
+    s.buffer += text;
+    if (!thread_.joinable()) {
+      thread_ = std::thread([this] { Run(); });
+    }
+    if (s.buffer.size() > (256u << 10)) {
+      cv_.notify_all();
+    }
+  }
+
+ private:
+  struct Slot {
+    std::string path;
+    std::string header;
+    std::string buffer;
+    bool reopen = false;
+    FILE* file = nullptr;
+  };
+
+  void Run() {
+    rex::thread::set_current_thread_name("BO2 Telemetrie");
+    std::unique_lock<std::mutex> lock(mutex_);
+    while (!stop_) {
+      cv_.wait_for(lock, std::chrono::milliseconds(500));
+      for (Slot& s : slots_) {
+        bool reopen = s.reopen;
+        s.reopen = false;
+        std::string path = s.path;
+        std::string header = s.header;
+        std::string data;
+        data.swap(s.buffer);
+        lock.unlock();
+        if (reopen) {
+          if (s.file) {
+            std::fclose(s.file);
+            s.file = nullptr;
+          }
+          if (!path.empty()) {
+            s.file = std::fopen(path.c_str(), "w");
+            if (s.file) {
+              std::fputs(header.c_str(), s.file);
+            }
+          }
+        }
+        if (s.file && !data.empty()) {
+          std::fwrite(data.data(), 1, data.size(), s.file);
+          std::fflush(s.file);
+        }
+        lock.lock();
+      }
+    }
+    for (Slot& s : slots_) {
+      if (s.file) {
+        std::fclose(s.file);
+        s.file = nullptr;
+      }
+    }
+  }
+
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  std::thread thread_;
+  bool stop_ = false;
+  Slot slots_[2];
+};
