+
+Entry* StfsContainerDevice::ResolveLanguageFallback(Entry* folder, const std::string_view file) {
+  // The language names titles use in file names (Call of Duty: english,
+  // british, german, austrian, french, frenchcan, ...). Only a request for
+  // one of them is redirected; what the package holds instead may be called
+  // anything.
+  static constexpr std::string_view kLanguages[] = {
+      "english",  "british",    "german",  "austrian", "french",  "frenchcan",
+      "italian",  "spanish",    "russian", "polish",   "japanese", "fulljap",
+      "korean",   "portuguese", "dutch",   "czech",    "chinese"};
+  auto is_language = [](std::string_view word) {
+    for (std::string_view language : kLanguages) {
+      if (word.size() == language.size() && rex::string::utf8_equal_case(word, language)) {
+        return true;
+      }
+    }
+    return false;
+  };
+  // <base>.<language>.<ext>
+  const size_t ext_dot = file.rfind('.');
+  if (ext_dot == std::string_view::npos || ext_dot == 0) {
+    return nullptr;
+  }
+  const size_t lang_dot = file.rfind('.', ext_dot - 1);
+  if (lang_dot == std::string_view::npos) {
+    return nullptr;
+  }
+  const std::string_view base = file.substr(0, lang_dot);
+  const std::string_view language = file.substr(lang_dot + 1, ext_dot - lang_dot - 1);
+  const std::string_view ext = file.substr(ext_dot + 1);
+  if (!is_language(language)) {
+    return nullptr;
+  }
+  // Any file of the same folder named <base>.<something>.<ext>: the same
+  // content for another language. English first if there are several;
+  // "all" is the part shared by every language, never a replacement.
+  Entry* found = nullptr;
+  int found_rank = 0;
+  for (const auto& child : folder->children()) {
+    const std::string_view name = child->name();
+    if (name.size() <= base.size() + ext.size() + 2 ||
+        !rex::string::utf8_equal_case(name.substr(0, base.size()), base) ||
+        name[base.size()] != '.' ||
+        !rex::string::utf8_equal_case(name.substr(name.size() - ext.size()), ext) ||
+        name[name.size() - ext.size() - 1] != '.') {
+      continue;
+    }
+    const std::string_view other =
+        name.substr(base.size() + 1, name.size() - base.size() - ext.size() - 2);
+    if (other.empty() || other.find('.') != std::string_view::npos ||
+        rex::string::utf8_equal_case(other, "all") ||
+        rex::string::utf8_equal_case(other, language)) {
+      continue;
+    }
+    const int rank = rex::string::utf8_equal_case(other, "english")   ? 3
+                     : rex::string::utf8_equal_case(other, "british") ? 2
+                                                                      : 1;
+    if (rank > found_rank) {
+      found = child.get();
+      found_rank = rank;
+    }
+  }
+  if (found) {
+    REXFS_WARN("{}: {} fehlt, nehme {} (Inhalt fuer eine andere Sprache)", name_, file,
+               found->name());
+    return found;
+  }
+  // Tell what is there instead, once per requested file: the next step
+  // depends on it.
+  if (language_misses_logged_ < 8) {
+    ++language_misses_logged_;
+    std::string listing;
+    for (const auto& child : folder->children()) {
+      if (listing.size() > 900) {
+        listing += " ...";
+        break;
+      }
+      listing += listing.empty() ? "" : ", ";
+      listing += child->name();
+    }
+    REXFS_WARN("{}: {} fehlt und es gibt keine andere Sprachfassung. Im Ordner: {}", name_, file,
+               listing);
+  }
+  return nullptr;
 }
 
