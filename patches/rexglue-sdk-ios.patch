@@ -0,0 +1,259 @@
+/**
+ * @file        ui/vulkan/moltenvk_config.cpp
+ * @brief       MoltenVK settings applied through its private API, and its
+ *              performance statistics
+ *
+ * @license     BSD 3-Clause License
+ */
+
+#include <rex/ui/vulkan/moltenvk_config.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <utility>
+
+#include <fmt/format.h>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_BOOL(mvk_synchronous_queue_submits, false, "GPU",
+                    "MoltenVK: encode Metal command buffers in the submitting thread (true) "
+                    "instead of MoltenVK's own queue thread (false)");
+REXCVAR_DEFINE_INT32(mvk_fast_math, 0, "GPU",
+                     "MoltenVK Metal fast math: 0 never, 1 always, 2 on demand");
+REXCVAR_DEFINE_INT32(mvk_log_level, 1, "GPU",
+                     "MoltenVK log level: 0 none, 1 errors, 2 warnings, 3 info, 4 debug");
+REXCVAR_DEFINE_BOOL(mvk_performance_tracking, false, "GPU",
+                    "MoltenVK performance statistics, logged with the GPU telemetry");
+REXCVAR_DEFINE_BOOL(mvk_maximize_concurrent_compilation, false, "GPU",
+                    "MoltenVK: compile each pipeline with many Metal threads");
+
+namespace rex::ui::vulkan {
+namespace {
+
+// Mirrors of the MoltenVK 1.4.1 private API structures (mvk_private_api.h).
+// MoltenVK copies only the common part and reports VK_INCOMPLETE if its
+// version uses a different size.
+struct MvkConfiguration {
+  uint32_t debugMode;
+  uint32_t shaderConversionFlipVertexY;
+  uint32_t synchronousQueueSubmits;
+  int32_t prefillMetalCommandBuffers;
+  uint32_t maxActiveMetalCommandBuffersPerQueue;
+  uint32_t supportLargeQueryPools;
+  uint32_t presentWithCommandBuffer;
+  uint32_t swapchainMinMagFilterUseNearest;
+  uint64_t metalCompileTimeout;
+  uint32_t performanceTracking;
+  uint32_t performanceLoggingFrameCount;
+  uint32_t displayWatermark;
+  uint32_t specializedQueueFamilies;
+  uint32_t switchSystemGPU;
+  uint32_t fullImageViewSwizzle;
+  uint32_t defaultGPUCaptureScopeQueueFamilyIndex;
+  uint32_t defaultGPUCaptureScopeQueueIndex;
+  int32_t fastMathEnabled;
+  int32_t logLevel;
+  int32_t traceVulkanCalls;
+  uint32_t forceLowPowerGPU;
+  uint32_t semaphoreUseMTLFence;
+  int32_t semaphoreSupportStyle;
+  int32_t autoGPUCaptureScope;
+  const char* autoGPUCaptureOutputFilepath;
+  uint32_t texture1DAs2D;
+  uint32_t preallocateDescriptors;
+  uint32_t useCommandPooling;
+  int32_t useMTLHeap;
+  int32_t activityPerformanceLoggingStyle;
+  uint32_t apiVersionToAdvertise;
+  uint32_t advertiseExtensions;
+  uint32_t resumeLostDevice;
+  uint32_t useMetalArgumentBuffers;
+  int32_t shaderSourceCompressionAlgorithm;
+  uint32_t shouldMaximizeConcurrentCompilation;
+  float timestampPeriodLowPassAlpha;
+  uint32_t useMetalPrivateAPI;
+  const char* shaderDumpDir;
+  uint32_t shaderLogEstimatedGLSL;
+  uint32_t liveCheckAllResources;
+};
+
+struct MvkPerformanceTracker {
+  uint32_t count;
+  double latest;
+  double previous;
+  double average;
+  double minimum;
+  double maximum;
+};
+
+struct MvkQueuePerformance {
+  MvkPerformanceTracker retrieveMTLCommandBuffer;
+  MvkPerformanceTracker commandBufferEncoding;
+  MvkPerformanceTracker waitSubmitCommandBuffers;
+  MvkPerformanceTracker submitCommandBuffers;
+  MvkPerformanceTracker mtlCommandBufferExecution;
+  MvkPerformanceTracker retrieveCAMetalDrawable;
+  MvkPerformanceTracker waitPresentSwapchains;
+  MvkPerformanceTracker presentSwapchains;
+  MvkPerformanceTracker frameInterval;
+};
+
+struct MvkShaderCompilationPerformance {
+  MvkPerformanceTracker hashShaderCode;
+  MvkPerformanceTracker spirvToMSL;
+  MvkPerformanceTracker mslCompile;
+  MvkPerformanceTracker mslLoad;
+  MvkPerformanceTracker mslCompress;
+  MvkPerformanceTracker mslDecompress;
+  MvkPerformanceTracker shaderLibraryFromCache;
+  MvkPerformanceTracker functionRetrieval;
+  MvkPerformanceTracker functionSpecialization;
+  MvkPerformanceTracker pipelineCompile;
+  MvkPerformanceTracker glslToSPRIV;
+};
+
+struct MvkPerformanceStatistics {
+  MvkShaderCompilationPerformance shaderCompilation;
+  MvkPerformanceTracker pipelineCache[3];
+  MvkQueuePerformance queue;
+  MvkPerformanceTracker gpuMemoryAllocated;
+};
+
+#if UINTPTR_MAX == 0xFFFFFFFFFFFFFFFFu
+static_assert(offsetof(MvkConfiguration, synchronousQueueSubmits) == 8);
+static_assert(offsetof(MvkConfiguration, metalCompileTimeout) == 32);
+static_assert(offsetof(MvkConfiguration, performanceTracking) == 40);
+static_assert(offsetof(MvkConfiguration, fastMathEnabled) == 72);
+static_assert(offsetof(MvkConfiguration, logLevel) == 76);
+static_assert(offsetof(MvkConfiguration, semaphoreSupportStyle) == 92);
+static_assert(offsetof(MvkConfiguration, autoGPUCaptureOutputFilepath) == 104);
+static_assert(offsetof(MvkConfiguration, useMTLHeap) == 124);
+static_assert(offsetof(MvkConfiguration, useMetalArgumentBuffers) == 144);
+static_assert(offsetof(MvkConfiguration, shouldMaximizeConcurrentCompilation) == 152);
+static_assert(offsetof(MvkConfiguration, shaderDumpDir) == 168);
+static_assert(sizeof(MvkConfiguration) == 184);
+static_assert(sizeof(MvkPerformanceTracker) == 48);
+static_assert(offsetof(MvkPerformanceStatistics, queue) == 672);
+static_assert(sizeof(MvkPerformanceStatistics) == 1152);
+#endif
+
+using PfnGetConfiguration = VkResult(VKAPI_PTR*)(VkInstance, MvkConfiguration*, size_t*);
+using PfnSetConfiguration = VkResult(VKAPI_PTR*)(VkInstance, const MvkConfiguration*, size_t*);
+using PfnGetPerformance = VkResult(VKAPI_PTR*)(VkDevice, MvkPerformanceStatistics*, size_t*);
+
+std::atomic<PfnGetPerformance> g_get_performance{nullptr};
+std::mutex g_performance_mutex;
+MvkPerformanceStatistics g_last_performance = {};
+
+std::string ConfigText(const MvkConfiguration& c) {
+  return fmt::format(
+      "synchrone Submits {}, Fast Math {}, Log {}, Leistungsmessung {}, parallele Kompilierung "
+      "{}, Semaphoren {}, MTLHeap {}, Argument Buffer {}, max. Command Buffer {}, Prefill {}",
+      c.synchronousQueueSubmits, c.fastMathEnabled, c.logLevel, c.performanceTracking,
+      c.shouldMaximizeConcurrentCompilation, c.semaphoreSupportStyle, c.useMTLHeap,
+      c.useMetalArgumentBuffers, c.maxActiveMetalCommandBuffersPerQueue,
+      c.prefillMetalCommandBuffers);
+}
+
+// Count and average of a running MoltenVK statistic between two readings.
+std::pair<uint32_t, double> Window(const MvkPerformanceTracker& now,
+                                   const MvkPerformanceTracker& before) {
+  if (now.count <= before.count) {
+    return {0, 0.0};
+  }
+  const uint32_t count = now.count - before.count;
+  const double total = now.average * double(now.count) - before.average * double(before.count);
+  return {count, std::max(0.0, total / double(count))};
+}
+
+std::string TrackerText(const char* name, const MvkPerformanceTracker& now,
+                        const MvkPerformanceTracker& before) {
+  const auto [count, average] = Window(now, before);
+  return fmt::format("{} {}x {:.2f} ms (max {:.1f})", name, count, average, now.maximum);
+}
+
+}  // namespace
+
+void ConfigureMoltenVK(const rex::platform::DynamicLibrary& library) {
+  const auto get_configuration =
+      library.GetSymbol<PfnGetConfiguration>("vkGetMoltenVKConfigurationMVK");
+  const auto set_configuration =
+      library.GetSymbol<PfnSetConfiguration>("vkSetMoltenVKConfigurationMVK");
+  g_get_performance.store(library.GetSymbol<PfnGetPerformance>("vkGetPerformanceStatisticsMVK"),
+                          std::memory_order_release);
+  if (!get_configuration || !set_configuration) {
+    return;
+  }
+  MvkConfiguration config = {};
+  size_t size = sizeof(config);
+  VkResult result = get_configuration(VK_NULL_HANDLE, &config, &size);
+  if (result != VK_SUCCESS) {
+    REXLOG_WARN("MoltenVK: Konfiguration nicht lesbar (Ergebnis {}, {} statt {} Bytes)",
+                int(result), size, sizeof(config));
+    return;
+  }
+  REXLOG_WARN("MoltenVK vorher (aus der Umgebung): {}", ConfigText(config));
+  config.synchronousQueueSubmits = REXCVAR_GET(mvk_synchronous_queue_submits) ? 1 : 0;
+  config.fastMathEnabled = std::clamp(REXCVAR_GET(mvk_fast_math), 0, 2);
+  config.logLevel = std::clamp(REXCVAR_GET(mvk_log_level), 0, 4);
+  config.performanceTracking = REXCVAR_GET(mvk_performance_tracking) ? 1 : 0;
+  // Never write performance logs by itself (read with the GPU telemetry).
+  config.performanceLoggingFrameCount = 0;
+  config.shouldMaximizeConcurrentCompilation =
+      REXCVAR_GET(mvk_maximize_concurrent_compilation) ? 1 : 0;
+  // Null string members keep MoltenVK's current values.
+  config.autoGPUCaptureOutputFilepath = nullptr;
+  config.shaderDumpDir = nullptr;
+  size = sizeof(config);
+  result = set_configuration(VK_NULL_HANDLE, &config, &size);
+  MvkConfiguration applied = {};
+  size = sizeof(applied);
+  if (get_configuration(VK_NULL_HANDLE, &applied, &size) == VK_SUCCESS) {
+    REXLOG_WARN("MoltenVK jetzt{}: {}", result == VK_SUCCESS ? "" : " (Setzen fehlgeschlagen)",
+                ConfigText(applied));
+  }
+}
+
+std::string TakeMoltenVKPerformanceText(VkDevice device) {
+  const PfnGetPerformance get_performance = g_get_performance.load(std::memory_order_acquire);
+  if (!get_performance || device == VK_NULL_HANDLE) {
+    return {};
+  }
+  MvkPerformanceStatistics stats = {};
+  size_t size = sizeof(stats);
+  if (get_performance(device, &stats, &size) != VK_SUCCESS) {
+    return {};
+  }
+  std::lock_guard<std::mutex> lock(g_performance_mutex);
+  const MvkPerformanceStatistics& last = g_last_performance;
+  const MvkQueuePerformance& q = stats.queue;
+  const MvkQueuePerformance& lq = last.queue;
+  if (q.submitCommandBuffers.count == lq.submitCommandBuffers.count &&
+      q.retrieveCAMetalDrawable.count == lq.retrieveCAMetalDrawable.count) {
+    return {};
+  }
+  std::string text = fmt::format(
+      "MoltenVK (10 s): {} | {} | {} | {} | {} | {} | {} | {} | {} | {}",
+      TrackerText("Drawable holen", q.retrieveCAMetalDrawable, lq.retrieveCAMetalDrawable),
+      TrackerText("Submit-Warteschlange", q.waitSubmitCommandBuffers,
+                  lq.waitSubmitCommandBuffers),
+      TrackerText("Kodieren", q.commandBufferEncoding, lq.commandBufferEncoding),
+      TrackerText("Submit", q.submitCommandBuffers, lq.submitCommandBuffers),
+      TrackerText("Command Buffer holen", q.retrieveMTLCommandBuffer,
+                  lq.retrieveMTLCommandBuffer),
+      TrackerText("GPU-Ausfuehrung", q.mtlCommandBufferExecution, lq.mtlCommandBufferExecution),
+      TrackerText("Present-Warteschlange", q.waitPresentSwapchains, lq.waitPresentSwapchains),
+      TrackerText("Present bis Anzeige", q.presentSwapchains, lq.presentSwapchains),
+      TrackerText("Pipelines", stats.shaderCompilation.pipelineCompile,
+                  last.shaderCompilation.pipelineCompile),
+      TrackerText("MSL", stats.shaderCompilation.mslCompile, last.shaderCompilation.mslCompile));
+  g_last_performance = stats;
+  return text;
+}
+
