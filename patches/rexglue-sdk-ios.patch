+void VulkanCommandProcessor::FinalizeRenderArea() {
+  if (render_area_begin_position_ == SIZE_MAX) {
+    return;
+  }
+  const size_t begin_position = render_area_begin_position_;
+  render_area_begin_position_ = SIZE_MAX;
+  const int32_t framebuffer_width = int32_t(render_area_framebuffer_extent_.width);
+  const int32_t framebuffer_height = int32_t(render_area_framebuffer_extent_.height);
+  if (render_area_full_ || framebuffer_width <= 0 || framebuffer_height <= 0) {
+    g_perf_render_area_passes += 1;
+    g_perf_render_area_permille += 1000;
+    return;
+  }
+  VkRect2D render_area;
+  const int32_t left = std::max(render_area_left_, int32_t(0));
+  const int32_t top = std::max(render_area_top_, int32_t(0));
+  const int32_t right = std::min(render_area_right_, framebuffer_width);
+  const int32_t bottom = std::min(render_area_bottom_, framebuffer_height);
+  if (right <= left || bottom <= top) {
+    // Nothing could have been drawn - keep the attachment traffic minimal.
+    render_area.offset.x = 0;
+    render_area.offset.y = 0;
+    render_area.extent.width = 1;
+    render_area.extent.height = 1;
+  } else {
+    render_area.offset.x = left;
+    render_area.offset.y = top;
+    render_area.extent.width = uint32_t(right - left);
+    render_area.extent.height = uint32_t(bottom - top);
+  }
+  if (deferred_command_buffer_.PatchBeginRenderArea(begin_position, render_area)) {
+    // Metal (MoltenVK) sizes the pass to offset + extent, count that.
+    g_perf_render_area_passes += 1;
+    g_perf_render_area_permille += uint32_t(
+        uint64_t(render_area.offset.x + render_area.extent.width) *
+        uint64_t(render_area.offset.y + render_area.extent.height) * 1000 /
+        (uint64_t(framebuffer_width) * uint64_t(framebuffer_height)));
+  }
+}
+
+void VulkanCommandProcessor::BeginRenderAreaTracking(const VkExtent2D& framebuffer_extent) {
+  // The begin command is written next - remember where, to shrink its render
+  // area to what the pass actually draws to when it ends.
+  if (!REXCVAR_GET(vulkan_render_area_tracking)) {
+    render_area_begin_position_ = SIZE_MAX;
+    return;
+  }
+  render_area_begin_position_ = deferred_command_buffer_.GetCommandStreamPosition();
+  render_area_framebuffer_extent_ = framebuffer_extent;
+  render_area_left_ = INT32_MAX;
+  render_area_top_ = INT32_MAX;
+  render_area_right_ = INT32_MIN;
+  render_area_bottom_ = INT32_MIN;
+  render_area_full_ = false;
+}
+
+void VulkanCommandProcessor::AddRectToRenderArea(const VkRect2D& rect) {
+  if (render_area_begin_position_ == SIZE_MAX || render_area_full_ || !in_render_pass_) {
+    return;
+  }
+  const int32_t left = rect.offset.x;
+  const int32_t top = rect.offset.y;
+  const int32_t right = left + int32_t(std::min(rect.extent.width, uint32_t(INT32_MAX / 2)));
+  const int32_t bottom = top + int32_t(std::min(rect.extent.height, uint32_t(INT32_MAX / 2)));
+  if (right <= left || bottom <= top) {
+    return;
+  }
+  render_area_left_ = std::min(render_area_left_, left);
+  render_area_top_ = std::min(render_area_top_, top);
+  render_area_right_ = std::max(render_area_right_, right);
+  render_area_bottom_ = std::max(render_area_bottom_, bottom);
+}
+
+void VulkanCommandProcessor::AddDrawToRenderArea() { AddRectToRenderArea(dynamic_scissor_); }
