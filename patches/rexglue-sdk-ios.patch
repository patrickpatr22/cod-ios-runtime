+  // the data first and reports the write when the read is done), so only act
+  // if the difference is still there about half a second later.
+  constexpr uint64_t kConfirmSubmissions = 30;
+  if (!audit_suspect_submission_) {
+    audit_suspect_submission_ = current_submission;
+    // Check again after kConfirmSubmissions instead of the full interval.
+    const uint64_t recheck_offset =
+        interval_submissions > kConfirmSubmissions ? interval_submissions - kConfirmSubmissions
+                                                   : 0;
+    audit_submission_ =
+        current_submission > recheck_offset ? current_submission - recheck_offset : 0;
+    return hashed_bytes;
+  }
+  audit_suspect_submission_ = 0;
+  const uint32_t stale_count =
+      texture_cache().stale_texture_count().fetch_add(1, std::memory_order_relaxed) + 1;
+  if (stale_count <= 40 || (stale_count % 500) == 0) {
+    REXGPU_WARN(
+        "Texturpruefung: veraltete Textur gefunden (Nr. {}): {} {}x{}x{} {} Basis {:08X} "
+        "({}) Mips {:08X} ({}) {}, wird neu geladen",
+        stale_count, FormatInfo::Get(key().format)->name, key().GetWidth(), key().GetHeight(),
+        key().GetDepthOrArraySize(), key().tiled ? "gekachelt" : "linear", base_address,
+        base_stale ? "geaendert" : "ok", mips_address, mips_stale ? "geaendert" : "ok",
+        key().packed_mips ? "gepackte Mips" : "");
+  }
+  // Mark the pages as modified by the CPU (so they're uploaded again) and
+  // notify the textures watching them, this one included.
+  if (base_stale) {
+    audit_base_valid_ = false;
+    shared_memory.MemoryInvalidationCallback(
+        base_address, GetHashedGuestRangeLength(base_address, GetGuestBaseSize()), true);
+  }
+  if (mips_stale) {
+    audit_mips_valid_ = false;
+    shared_memory.MemoryInvalidationCallback(
+        mips_address, GetHashedGuestRangeLength(mips_address, GetGuestMipsSize()), true);
+  }
+  return hashed_bytes;
+}
