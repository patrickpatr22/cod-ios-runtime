+const char* ThermalName(int thermal) {
+  switch (thermal) {
+    case 0:
+      return "normal";
+    case 1:
+      return "erhoeht";
+    case 2:
+      return "hoch (drosselt)";
+    case 3:
+      return "kritisch";
+    default:
+      return "?";
+  }
+}
+
+std::string LimiterText(const uint32_t* counts, uint32_t total, bool compact) {
+  std::string text;
+  for (uint32_t i = 0; i < kLimCount; ++i) {
+    if (!counts[i]) {
+      continue;
+    }
+    text += fmt::format("{}{} {}", text.empty() ? "" : (compact ? " " : " | "),
+                        compact ? kLimiterShort[i] : kLimiterNames[i], Percent(counts[i], total));
+  }
+  return text.empty() ? "-" : text;
+}
+
+std::string WorkText(const Stats& w, bool compact) {
+  const double n = std::max(double(w.frames), 1.0);
+  std::string text = fmt::format("GPU {:.1f}", w.gpu_sum / n);
+  for (uint32_t i : {kRoleMain, kRoleRender, kRoleJobs, kRoleServer, kRoleCp}) {
+    const RoleTimes& r = w.role_sums[i];
+    if (!r.threads) {
+      continue;
+    }
+    if (compact) {
+      text += fmt::format(" | {} {:.1f}+{:.1f}", kRoleNames[i], r.work() / n, r.yield_ms / n);
+    } else {
+      text += fmt::format(" | {}{} {:.1f} (+{:.1f} Spin, {:.1f} Warten, {:.1f} Schlaf)",
+                          kRoleNames[i], r.threads > 1 ? fmt::format(" {}x", r.threads) : "",
+                          r.work() / n, r.yield_ms / n, r.wait_ms / n, r.sleep_ms / n);
+    }
+  }
+  text += fmt::format(" | Faults {:.2f} ms", w.fault_sum / n);
+  return text;
+}
+
+std::string DisplayText(const Stats& w, bool compact, double seconds) {
+  seconds = std::max(seconds, 0.001);
+  uint32_t hist_total = 0;
+  for (uint32_t c : w.display_hist) {
+    hist_total += c;
+  }
+  if (!w.presents && !w.displayed) {
+    return "Anzeige: keine Daten";
+  }
+  const uint64_t refresh_ns = rex::ui::DisplayRefreshDurationNs();
+  std::string text = fmt::format("Anzeige: {:.1f} gezeigt/s (gerendert {:.1f})",
+                                 w.displayed / seconds, w.frames / seconds);
+  text += fmt::format(" | Abstand 1x {} 2x {} 3x {} 4x+ {}",
+                      Percent(w.display_hist[0], hist_total), Percent(w.display_hist[1], hist_total),
+                      Percent(w.display_hist[2], hist_total),
+                      Percent(w.display_hist[3] + w.display_hist[4], hist_total));
+  if (!compact) {
+    text += fmt::format(" (Takt {:.2f} ms)", refresh_ns ? double(refresh_ns) * kNsToMs : 0.0);
+    text += fmt::format(" | nie gezeigt {} | Wiederholt {}", w.never_displayed, w.repaints);
+  }
+  if (w.latency_count) {
+    text += fmt::format(" | Latenz CP->Bild {:.0f} ms", w.latency_cp_sum / w.latency_count);
+  }
+  if (w.latency_guest_count) {
+    text += fmt::format(" Spiel->Bild {:.0f} ms", w.latency_guest_sum / w.latency_guest_count);
+  }
+  text += fmt::format(" | Temp {}", ThermalName(w.thermal_max));
+  if (REXCVAR_GET(perf_low_power_mode)) {
+    text += " | Stromsparmodus!";
+  }
+  return text;
+}
+
+std::string FrameTimeText(const Stats& w) {
+  return fmt::format("Bildzeit p50 {:.1f} p95 {:.1f} p99 {:.1f} max {:.0f} ms | >16,7 ms {} >25 ms {}",
+                     w.Percentile(0.5), w.Percentile(0.95), w.Percentile(0.99), w.MaxInterval(),
+                     Percent(w.slow[0], w.frames), Percent(w.slow[1], w.frames));
+}
+
+void LogThreadDetails(State& s) {
+  // Guest waits and cores per tracked thread since the last report.
+  std::string text;
+  std::string cores;
+  for (TrackedThread& t : s.tracked) {
+    uint64_t wait_kind[4], delay_kind[3], cpu[rex::thread::ThreadTimeCounters::kCpuSlots];
+    uint64_t total_wait = 0;
+    for (int i = 0; i < 4; ++i) {
+      const uint64_t v = t.counters->guest_wait_kind[i].load(std::memory_order_relaxed);
+      wait_kind[i] = v - t.log_wait_kind[i];
+      t.log_wait_kind[i] = v;
+      total_wait += wait_kind[i];
+    }
+    const uint64_t polls = t.counters->guest_poll_timeouts.load(std::memory_order_relaxed);
+    const uint64_t poll_timeouts = polls - t.log_poll_timeouts;
+    t.log_poll_timeouts = polls;
+    uint64_t total_delay = 0;
+    for (int i = 0; i < 3; ++i) {
+      const uint64_t v = t.counters->guest_delay_kind[i].load(std::memory_order_relaxed);
+      delay_kind[i] = v - t.log_delay_kind[i];
+      t.log_delay_kind[i] = v;
+      total_delay += delay_kind[i];
+    }
+    const uint64_t yields_now = t.counters->yield_count.load(std::memory_order_relaxed);
+    const uint64_t yields = yields_now - t.log_yields;
+    t.log_yields = yields_now;
+    uint64_t cpu_total = 0;
+    for (size_t i = 0; i < rex::thread::ThreadTimeCounters::kCpuSlots; ++i) {
+      const uint32_t v = t.counters->cpu_samples[i].load(std::memory_order_relaxed);
+      cpu[i] = v - t.log_cpu[i];
+      t.log_cpu[i] = v;
+      cpu_total += cpu[i];
+    }
+    if (total_wait || total_delay || yields) {
+      text += fmt::format(
+          " | {}: Yields {}, Waits {} (0 ms {} davon Timeout {}, <1 ms {}, ms {}, unendlich {}), "
+          "Delays {} (0 {}, <1 ms {}, ms {})",
+          t.name.substr(0, 16), yields, total_wait, wait_kind[0], poll_timeouts, wait_kind[1],
+          wait_kind[2], wait_kind[3], total_delay, delay_kind[0], delay_kind[1], delay_kind[2]);
+    }
+    if (cpu_total) {
+      std::string per_cpu;
+      for (size_t i = 0; i < rex::thread::ThreadTimeCounters::kCpuSlots; ++i) {
+        if (cpu[i]) {
+          per_cpu += fmt::format(" c{} {:.0f}%", i, 100.0 * double(cpu[i]) / double(cpu_total));
+        }
+      }
+      cores += fmt::format(" | {}:{}", t.name.substr(0, 16), per_cpu);
+    }
+  }
+  if (!text.empty()) {
+    REXGPU_WARN("Threads (10 s){}", text);
+  }
+  if (!cores.empty()) {
+    REXGPU_WARN("Kerne (Stichproben){}", cores);
+  }
+  if (!s.logged_cpu_layout) {
+    s.logged_cpu_layout = true;
+#if defined(__APPLE__)
+    int p_cores = 0, e_cores = 0;
+    size_t size = sizeof(int);
+    sysctlbyname("hw.perflevel0.logicalcpu", &p_cores, &size, nullptr, 0);
+    size = sizeof(int);
+    sysctlbyname("hw.perflevel1.logicalcpu", &e_cores, &size, nullptr, 0);
+    REXGPU_WARN("CPU-Aufbau: {} Leistungskerne (perflevel0), {} Effizienzkerne (perflevel1)",
+                p_cores, e_cores);
+#endif
+  }
+}
+
+void ProcessDisplay(State& s) {
+  s.display_scratch.clear();
+  rex::ui::DrainPresentTiming(s.display_scratch);
+  if (s.display_scratch.empty()) {
+    return;
+  }
+  const uint64_t refresh_ns = std::max<uint64_t>(rex::ui::DisplayRefreshDurationNs(), 1000000);
+  std::string csv;
+  const std::string csv_path = REXCVAR_GET(perf_csv_display);
+  for (const rex::ui::PresentTimingRecord& r : s.display_scratch) {
+    Stats* windows[3] = {&s.overlay, &s.log, nullptr};
+    if (!s.ab_label.empty() && s.ab_measuring) {
+      windows[2] = &s.ab[s.ab_label];
+    }
+    if (!r.has_display_time) {
+      for (Stats* w : windows) {
+        if (w) {
+          ++w->presents;
+          w->repaints += r.repaint ? 1 : 0;
+        }
+      }
+      if (!csv_path.empty()) {
+        csv += fmt::format("p,{},{},{:.3f}\n", r.frame_id, r.repaint,
+                           double(r.present_call_ns - s.start_ns) * kNsToMs);
+      }
+      continue;
+    }
+    if (!r.actual_present_ns) {
+      for (Stats* w : windows) {
+        if (w) {
+          ++w->never_displayed;
+        }
+      }
+      if (!csv_path.empty()) {
+        csv += fmt::format("d,{},{},0\n", r.frame_id, r.repaint);
+      }
+      continue;
+    }
+    uint32_t refreshes = 0;
+    if (s.last_display_ns && r.actual_present_ns > s.last_display_ns) {
+      const double units =
+          double(r.actual_present_ns - s.last_display_ns) / double(refresh_ns);
+      refreshes = uint32_t(std::clamp(units + 0.5, 1.0, 5.0));
+    }
+    s.last_display_ns = std::max(s.last_display_ns, r.actual_present_ns);
+    double latency_cp = -1.0, latency_guest = -1.0;
+    if (r.frame_id && r.repaint == 0) {
+      for (auto it = s.swap_times.rbegin(); it != s.swap_times.rend(); ++it) {
+        if (it->first == r.frame_id) {
+          if (it->second.first && r.actual_present_ns > it->second.first) {
+            latency_cp = double(r.actual_present_ns - it->second.first) * kNsToMs;
+          }
+          if (it->second.second && r.actual_present_ns > it->second.second) {
+            latency_guest = double(r.actual_present_ns - it->second.second) * kNsToMs;
+          }
+          break;
+        }
+      }
+    }
+    for (Stats* w : windows) {
+      if (!w) {
+        continue;
+      }
+      ++w->displayed;
+      if (refreshes) {
+        ++w->display_hist[refreshes - 1];
+      }
+      if (latency_cp >= 0.0 && latency_cp < 1000.0) {
+        w->latency_cp_sum += latency_cp;
+        ++w->latency_count;
+      }
+      if (latency_guest >= 0.0 && latency_guest < 1000.0) {
+        w->latency_guest_sum += latency_guest;
+        ++w->latency_guest_count;
+      }
+    }
+    if (!csv_path.empty()) {
+      csv += fmt::format("d,{},{},{:.3f}\n", r.frame_id, r.repaint,
+                         double(r.actual_present_ns - s.start_ns) * kNsToMs);
+    }
+  }
+  if (!csv.empty()) {
+    s.csv.Append(1, csv_path, kDisplayCsvHeader, std::move(csv));
+  }
+}
+
+void WriteFrameCsv(State& s, const FrameRecord& f) {
+  const std::string path = REXCVAR_GET(perf_csv_frames);
+  if (path.empty()) {
+    return;
+  }
+  const RoleTimes* r = f.roles;
+  const SwapCounters& c = f.counters;
+  std::string row = fmt::format(
+      "{},{:.3f},{:.2f},{:.2f},{},{:.2f},{:.2f},{:.2f},{:.2f},{:.2f},{:.2f},{:.2f},{:.2f},{:.2f},"
+      "{:.2f},{:.2f},{:.2f},{:.2f},{:.2f},{:.3f},{},{},{},{},{},{},{:.0f},{},{},{},{},{},{},{:.0f},"
+      "{},{},{}\n",
+      f.index, double(f.cp_swap_ns - s.start_ns) * 1e-9, f.interval_ms, f.guest_interval_ms,
+      f.guest_ahead, f.gpu_ms, r[kRoleMain].cpu_ms, r[kRoleMain].yield_ms, r[kRoleMain].wait_ms,
+      r[kRoleRender].cpu_ms, r[kRoleRender].yield_ms, r[kRoleRender].wait_ms, r[kRoleJobs].cpu_ms,
+      r[kRoleJobs].yield_ms, r[kRoleServer].cpu_ms, r[kRoleServer].yield_ms, r[kRoleCp].cpu_ms,
+      r[kRoleCp].yield_ms, c.fence_wait_ms, f.fault_ms, c.draws, c.render_passes, c.upload_breaks,
+      c.texture_load_breaks, c.resolves, c.uploads, double(c.upload_bytes) / 1024.0,
+      c.texture_loads, c.access_violations, c.memexport_draws, c.pipelines_created,
+      c.shader_wait ? 1 : 0, c.presented ? 1 : 0,
+      c.render_area_passes ? double(c.render_area_permille) / (10.0 * c.render_area_passes)
+                           : 100.0,
+      f.thermal, kLimiterShort[f.limiter], f.ab_label);
+  s.csv.Append(0, path, kFramesCsvHeader, std::move(row));
+}
+
+void FinalizeFrame(State& s, FrameRecord& f) {
+  rex::ui::pacing::OnFrameFinished(f.gpu_ms, f.interval_ms);
+  f.limiter = Classify(f);
+  s.overlay.AddFrame(f);
+  s.log.AddFrame(f);
+  if (!f.ab_label.empty() && f.ab_measuring) {
+    s.ab[f.ab_label].AddFrame(f);
+  }
+  WriteFrameCsv(s, f);
+}
+
+void UpdateWindows(State& s, uint64_t now_ns) {
+  if (!s.overlay.start_ns) {
+    s.overlay.start_ns = now_ns;
+  }
+  if (!s.log.start_ns) {
+    s.log.start_ns = now_ns;
+  }
+  s.overlay.end_ns = now_ns;
+  s.log.end_ns = now_ns;
+  for (auto& [label, stats] : s.ab) {
+    (void)label;
+    if (!stats.start_ns) {
+      stats.start_ns = now_ns;
+    }
+  }
+  if (!s.ab_label.empty() && s.ab_measuring) {
+    Stats& ab = s.ab[s.ab_label];
+    if (!ab.start_ns) {
+      ab.start_ns = now_ns;
+    }
+    ab.end_ns = std::max(ab.end_ns, now_ns);
+  }
+  if (now_ns - s.overlay.start_ns >= 3000000000ull) {
+    const Stats& w = s.overlay;
+    if (w.frames) {
+      s.overlay_text = fmt::format(
+          "Engpass: {} | p95 {:.1f} ms, >16,7 ms {}\nArbeit/Bild ms: {}\n{} | Takt {}",
+          LimiterText(w.limiter_all, w.frames, true), w.Percentile(0.95),
+          Percent(w.slow[0], w.frames), WorkText(w, true), DisplayText(w, true, w.Seconds()),
+          rex::ui::pacing::StatusText());
+    }
+    s.overlay = Stats();
+    s.overlay.start_ns = now_ns;
+  }
+  if (now_ns - s.log.start_ns >= 10000000000ull) {
+    const Stats& w = s.log;
+    if (w.frames) {
+      REXGPU_WARN("Engpass ({} Bilder): {} || langsame Bilder (>16,7 ms, {}): {}", w.frames,
+                  LimiterText(w.limiter_all, w.frames, false), Percent(w.slow[0], w.frames),
+                  LimiterText(w.limiter_slow, w.slow[0], false));
+      REXGPU_WARN("{} | Arbeit pro Bild ms: {} | Gast voraus {:.1f} Bilder", FrameTimeText(w),
+                  WorkText(w, false), w.guest_ahead_sum / std::max(double(w.frames), 1.0));
+      REXGPU_WARN("{}", DisplayText(w, false, w.Seconds()));
+      {
+        // Presentation on the UI thread (it also handles touch and controller
+        // events, so long waits there delay input).
+        const rex::ui::PaintTimingTotals paint = rex::ui::ReadPaintTiming();
+        const uint64_t count = paint.count - s.last_paint.count;
+        if (count) {
+          const double n = double(count);
+          auto per_paint = [&](uint64_t now_total, uint64_t last_total) {
+            return double(now_total - last_total) * kNsToMs / n;
+          };
+          REXGPU_WARN(
+              "UI-Thread Malen: {:.1f}/s, je {:.2f} ms, davon CPU {:.2f} | Drawable {:.2f} | "
+              "frueheres Malen {:.2f} | Gastbild {:.2f} | UI {:.2f} | Queue-Sperre {:.2f} | "
+              "Submit {:.2f} | Present {:.2f} | max {:.1f} ms | getaktet {}",
+              n / std::max(w.Seconds(), 0.001), per_paint(paint.total_ns, s.last_paint.total_ns),
+              per_paint(paint.cpu_ns, s.last_paint.cpu_ns),
+              per_paint(paint.acquire_ns, s.last_paint.acquire_ns),
+              per_paint(paint.await_ns, s.last_paint.await_ns),
+              per_paint(paint.consume_ns, s.last_paint.consume_ns),
+              per_paint(paint.ui_ns, s.last_paint.ui_ns),
+              per_paint(paint.queue_lock_ns, s.last_paint.queue_lock_ns),
+              per_paint(paint.submit_ns, s.last_paint.submit_ns),
+              per_paint(paint.present_ns, s.last_paint.present_ns),
+              double(paint.max_total_ns) * kNsToMs, paint.paced - s.last_paint.paced);
+        }
+        s.last_paint = paint;
+        REXGPU_WARN("{}", rex::ui::pacing::TakeLogText());
+      }
+      LogThreadDetails(s);
+    }
+    s.log = Stats();
+    s.log.start_ns = now_ns;
+  }
+}
+
+}  // namespace
+
+uint64_t OnSwap(const SwapCounters& counters) {
+  State& s = GetState();
+  const uint64_t now_ns = rex::thread::MonotonicNowNs();
+  if (!s.start_ns) {
+    s.start_ns = now_ns;
+  }
+  RescanThreads(s, now_ns);
+  FrameRecord& f = s.pending.emplace_back();
+  f.index = ++s.frame_counter;
+  f.cp_swap_ns = now_ns;
+  f.interval_ms = s.last_cp_swap_ns ? double(now_ns - s.last_cp_swap_ns) * kNsToMs : 0.0;
+  s.last_cp_swap_ns = now_ns;
+  ++s.cp_swaps;
+  // The guest swap this CP swap belongs to: guest swaps are counted when the
+  // title calls VdSwap, CP swaps when the packet is executed.
+  const uint64_t guest_swaps = rex::kernel::xboxkrnl::GuestSwapCount();
+  f.guest_ahead = int64_t(guest_swaps) - int64_t(s.cp_swaps);
+  f.guest_swap_ns = rex::kernel::xboxkrnl::GuestSwapTimeNs(s.cp_swaps);
+  if (f.guest_swap_ns && s.last_guest_swap_ns && f.guest_swap_ns > s.last_guest_swap_ns) {
+    f.guest_interval_ms = double(f.guest_swap_ns - s.last_guest_swap_ns) * kNsToMs;
+  }
+  if (f.guest_swap_ns) {
+    s.last_guest_swap_ns = f.guest_swap_ns;
+  }
+  f.first_submission = s.last_submission_seen + 1;
+  f.counters = counters;
+  f.thermal = REXCVAR_GET(perf_thermal_state);
+  f.ab_label = s.ab_label;
+  f.ab_measuring = s.ab_measuring;
+  SampleThreads(s, f);
+  const uint64_t fault_ns =
+      rex::thread::g_access_violation_handling_ns.load(std::memory_order_relaxed);
+  f.fault_ms = double(fault_ns - s.last_fault_ns) * kNsToMs;
+  s.last_fault_ns = fault_ns;
+  s.swap_times.emplace_back(f.index, std::make_pair(f.cp_swap_ns, f.guest_swap_ns));
+  while (s.swap_times.size() > 512) {
+    s.swap_times.pop_front();
+  }
+  // Frames whose submission never completes (device loss) don't pile up.
+  while (s.pending.size() > 64) {
+    s.pending.pop_front();
+  }
+  ProcessDisplay(s);
+  UpdateWindows(s, now_ns);
+  return f.index;
+}
+
+void OnSwapSubmitted(uint64_t frame_index, uint64_t last_submission) {
+  State& s = GetState();
+  for (auto it = s.pending.rbegin(); it != s.pending.rend(); ++it) {
+    if (it->index == frame_index) {
+      it->last_submission = std::max(last_submission, it->first_submission);
+      it->submitted = true;
+      s.last_submission_seen = std::max(s.last_submission_seen, it->last_submission);
+      break;
+    }
+  }
+}
+
+void OnSubmissionGpuTime(uint64_t submission, double ms) {
+  State& s = GetState();
+  for (FrameRecord& f : s.pending) {
+    if (submission < f.first_submission) {
+      continue;
+    }
+    if (!f.submitted || submission <= f.last_submission) {
+      f.gpu_ms += ms;
+      return;
+    }
+  }
+}
+
+void OnCompletedSubmission(uint64_t completed_submission) {
+  State& s = GetState();
+  while (!s.pending.empty() && s.pending.front().submitted &&
+         s.pending.front().last_submission <= completed_submission) {
+    FinalizeFrame(s, s.pending.front());
+    s.pending.pop_front();
+  }
+}
+
+std::string OverlayText() { return GetState().overlay_text; }
+
+void SetAbPhase(const std::string& label, bool measuring) {
+  State& s = GetState();
+  s.ab_label = label;
+  s.ab_measuring = measuring;
+}
+
+std::string AbReport() {
+  State& s = GetState();
+  std::string text;
+  for (const auto& [label, w] : s.ab) {
+    if (!w.frames) {
+      continue;
+    }
+    const double seconds = std::max(w.interval_sum * 1e-3, 0.001);
+    text += fmt::format(
+        "{}: {:.1f} FPS, {} | Engpass {} | {} | {} | Gast voraus {:.1f}\n", label,
+        w.frames / seconds, FrameTimeText(w), LimiterText(w.limiter_all, w.frames, true),
+        WorkText(w, true), DisplayText(w, true, seconds),
+        w.guest_ahead_sum / std::max(double(w.frames), 1.0));
+  }
+  return text;
+}
+
+}  // namespace rex::graphics::vulkan::telemetry
