+// Statistics of a window of frames (overlay, log, one A/B configuration).
+struct Stats {
+  uint32_t frames = 0;
+  double interval_sum = 0.0;
+  double gpu_sum = 0.0;
+  RoleTimes role_sums[kRoleCount];
+  double fault_sum = 0.0;
+  double fence_wait_sum = 0.0;
+  uint32_t slow[3] = {};  // > 16.9, > 25, > 50 ms
+  uint32_t limiter_all[kLimCount] = {};
+  uint32_t limiter_slow[kLimCount] = {};
+  std::vector<float> intervals;
+  uint32_t shader_wait = 0;
+  uint32_t not_presented = 0;
+  double guest_ahead_sum = 0.0;
+  uint64_t draws = 0;
+  uint64_t passes = 0;
+  // Display.
+  uint32_t displayed = 0;
+  uint32_t never_displayed = 0;
+  uint32_t presents = 0;
+  uint32_t repaints = 0;
+  uint32_t display_hist[5] = {};  // 1, 2, 3, 4, 5+ refreshes between shown images
+  double latency_cp_sum = 0.0;
+  double latency_guest_sum = 0.0;
+  uint32_t latency_count = 0;
+  uint32_t latency_guest_count = 0;
+  uint64_t start_ns = 0;
+  uint64_t end_ns = 0;
+  int thermal_max = -1;
+
+  void AddFrame(const FrameRecord& f) {
+    ++frames;
+    interval_sum += f.interval_ms;
+    gpu_sum += f.gpu_ms;
+    for (uint32_t i = 0; i < kRoleCount; ++i) {
+      role_sums[i].cpu_ms += f.roles[i].cpu_ms;
+      role_sums[i].yield_ms += f.roles[i].yield_ms;
+      role_sums[i].wait_ms += f.roles[i].wait_ms;
+      role_sums[i].sleep_ms += f.roles[i].sleep_ms;
+      role_sums[i].threads = std::max(role_sums[i].threads, f.roles[i].threads);
+    }
+    fault_sum += f.fault_ms;
+    fence_wait_sum += f.counters.fence_wait_ms;
+    const bool is_slow = f.interval_ms > 16.9;
+    slow[0] += is_slow ? 1 : 0;
+    slow[1] += f.interval_ms > 25.0 ? 1 : 0;
+    slow[2] += f.interval_ms > 50.0 ? 1 : 0;
+    ++limiter_all[f.limiter];
+    if (is_slow) {
+      ++limiter_slow[f.limiter];
+    }
+    intervals.push_back(float(f.interval_ms));
+    shader_wait += f.counters.shader_wait ? 1 : 0;
+    not_presented += f.counters.presented ? 0 : 1;
+    guest_ahead_sum += double(f.guest_ahead);
+    draws += f.counters.draws;
+    passes += f.counters.render_passes;
+    thermal_max = std::max(thermal_max, f.thermal);
+  }
+
+  double Percentile(double p) const {
+    if (intervals.empty()) {
+      return 0.0;
+    }
+    std::vector<float> sorted(intervals);
+    const size_t n = std::min(sorted.size() - 1, size_t(p * double(sorted.size() - 1) + 0.5));
+    std::nth_element(sorted.begin(), sorted.begin() + n, sorted.end());
+    return sorted[n];
+  }
+  double MaxInterval() const {
+    return intervals.empty() ? 0.0 : *std::max_element(intervals.begin(), intervals.end());
+  }
+  double Seconds() const { return end_ns > start_ns ? double(end_ns - start_ns) * 1e-9 : 0.0; }
+};
