+std::string FrameDumpFloat4(const RegisterFile& regs, uint32_t constant_index) {
+  const float* c = reinterpret_cast<const float*>(
+      &regs.values[XE_GPU_REG_SHADER_CONSTANT_000_X + 4 * (constant_index & 511)]);
+  return fmt::format("({:.4g} {:.4g} {:.4g} {:.4g})", c[0], c[1], c[2], c[3]);
+}
+
+void FrameDumpDraw(const RegisterFile& regs, xenos::PrimitiveType prim_type,
+                   uint32_t guest_index_count, uint32_t host_vertex_count,
+                   const Shader* vertex_shader, const Shader* pixel_shader,
+                   uint32_t normalized_color_mask, bool memexport_vs, bool memexport_ps,
+                   size_t memexport_range_count, bool placeholder) {
+  std::string& t = g_frame_dump.text;
+  const auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  const auto scissor_tl = regs.Get<reg::PA_SC_WINDOW_SCISSOR_TL>();
+  const auto scissor_br = regs.Get<reg::PA_SC_WINDOW_SCISSOR_BR>();
+  const uint32_t scissor_w = scissor_br.br_x > scissor_tl.tl_x ? scissor_br.br_x - scissor_tl.tl_x : 0;
+  const uint32_t scissor_h = scissor_br.br_y > scissor_tl.tl_y ? scissor_br.br_y - scissor_tl.tl_y : 0;
+  // Details (all pixel shader constants, shader disassembly) for full-screen
+  // and post-processing passes (quads) and small special render targets.
+  const bool full_screen = g_frame_dump.manual || (scissor_w >= 512 && scissor_h >= 256) ||
+                           host_vertex_count <= 6 || (scissor_w <= 64 && scissor_h >= 512);
+  t += fmt::format(
+      "D{:04} prim={} n={} host_n={} vs={:016X} ps={:016X} edram_mode={} pitch={} msaa={} "
+      "scissor={},{}+{}x{} vp=({:.1f},{:.1f} s {:.1f},{:.1f}) depthctl={:08X} colorctl={:08X}{}{}",
+      g_frame_dump.draw_index++, uint32_t(prim_type), guest_index_count, host_vertex_count,
+      vertex_shader ? vertex_shader->ucode_data_hash() : 0,
+      pixel_shader ? pixel_shader->ucode_data_hash() : 0,
+      uint32_t(regs.Get<reg::RB_MODECONTROL>().edram_mode), surface_info.surface_pitch,
+      uint32_t(surface_info.msaa_samples), scissor_tl.tl_x, scissor_tl.tl_y, scissor_w, scissor_h,
+      regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET), regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET),
+      regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE), regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE),
+      regs[XE_GPU_REG_RB_DEPTHCONTROL], regs[XE_GPU_REG_RB_COLORCONTROL],
+      memexport_vs || memexport_ps
+          ? fmt::format(" memexport={}{} ranges={}", memexport_vs ? "V" : "",
+                        memexport_ps ? "P" : "", memexport_range_count)
+          : std::string(),
+      placeholder ? " PLACEHOLDER" : "");
+  static constexpr uint32_t kColorInfoRegs[4] = {XE_GPU_REG_RB_COLOR_INFO, XE_GPU_REG_RB_COLOR1_INFO,
+                                                 XE_GPU_REG_RB_COLOR2_INFO,
+                                                 XE_GPU_REG_RB_COLOR3_INFO};
+  static constexpr uint32_t kBlendRegs[4] = {XE_GPU_REG_RB_BLENDCONTROL0, XE_GPU_REG_RB_BLENDCONTROL1,
+                                             XE_GPU_REG_RB_BLENDCONTROL2,
+                                             XE_GPU_REG_RB_BLENDCONTROL3};
+  for (uint32_t i = 0; i < 4; ++i) {
+    const uint32_t mask = (normalized_color_mask >> (i * 4)) & 0xF;
+    if (!mask) {
+      continue;
+    }
+    const auto color_info = regs.Get<reg::RB_COLOR_INFO>(kColorInfoRegs[i]);
+    t += fmt::format(" rt{}={}@{} bias={} mask={:X} blend={:08X}", i,
+                     xenos::GetColorRenderTargetFormatName(color_info.color_format),
+                     color_info.color_base | (color_info.color_base_bit_11 << 11),
+                     int32_t(color_info.color_exp_bias), mask, regs[kBlendRegs[i]]);
+  }
+  const auto depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+  t += fmt::format(" depth={}@{}", uint32_t(depth_info.depth_format),
+                   depth_info.depth_base | (depth_info.depth_base_bit_11 << 11));
+  if (pixel_shader) {
+    for (const Shader::TextureBinding& binding : pixel_shader->texture_bindings()) {
+      const xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(binding.fetch_constant);
+      // S = stacked (2D array), m = mip levels, mip address, signedness.
+      const std::string mip_text =
+          fmt::format("m{}-{}@{:08X}{}", uint32_t(fetch.mip_min_level),
+                      uint32_t(fetch.mip_max_level), fetch.mip_address << 12,
+                      (uint32_t(fetch.sign_x) | uint32_t(fetch.sign_y) | uint32_t(fetch.sign_z) |
+                       uint32_t(fetch.sign_w))
+                          ? fmt::format("s{}{}{}{}", uint32_t(fetch.sign_x), uint32_t(fetch.sign_y),
+                                        uint32_t(fetch.sign_z), uint32_t(fetch.sign_w))
+                          : std::string());
+      if (fetch.dimension == xenos::DataDimension::k3D) {
+        t += fmt::format(" t{}={}:{}x{}x{}/3D{}@{:08X}{}/{}", binding.fetch_constant,
+                         FormatInfo::Get(fetch.format)->name, fetch.size_3d.width + 1,
+                         fetch.size_3d.height + 1, fetch.size_3d.depth + 1,
+                         fetch.stacked ? "S" : "", fetch.base_address << 12,
+                         fetch.tiled ? "T" : "L", mip_text);
+      } else {
+        t += fmt::format(" t{}={}:{}x{}{}@{:08X}{}/{}", binding.fetch_constant,
+                         FormatInfo::Get(fetch.format)->name, fetch.size_2d.width + 1,
+                         fetch.size_2d.height + 1,
+                         fetch.dimension == xenos::DataDimension::kCube ? "/Cube" : "",
+                         fetch.base_address << 12, fetch.tiled ? "T" : "L", mip_text);
+      }
+      if (full_screen) {
+        // Sampling parameters that change the values the shader sees.
+        t += fmt::format("[op{} sign{}{}{}{} nf{} exp{} sw{:03X} end{} stk{} mips{}-{}]",
+                         uint32_t(binding.fetch_instr.dimension), uint32_t(fetch.sign_x),
+                         uint32_t(fetch.sign_y), uint32_t(fetch.sign_z), uint32_t(fetch.sign_w),
+                         fetch.num_format, int32_t(fetch.exp_adjust), fetch.swizzle,
+                         uint32_t(fetch.endianness), fetch.stacked, fetch.mip_min_level,
+                         fetch.mip_max_level);
+      }
+    }
+    if (full_screen) {
+      // All float constants the pixel shader reads (up to 24), plus the bool
+      // constants, so the parameters of full-screen passes can be checked.
+      const uint32_t ps_base = regs.Get<reg::SQ_PS_CONST>().base;
+      const Shader::ConstantRegisterMap& map = pixel_shader->constant_register_map();
+      uint32_t printed = 0;
+      for (uint32_t i = 0; i < 256 && printed < 40; ++i) {
+        if (map.float_dynamic_addressing ? i < 40
+                                         : ((map.float_bitmap[i >> 6] >> (i & 63)) & 1) != 0) {
+          t += fmt::format(" c{}={}", i, FrameDumpFloat4(regs, ps_base + i));
+          ++printed;
+        }
+      }
+      t += fmt::format(" bool={:08X}{:08X} blendconst=({:.3g} {:.3g} {:.3g} {:.3g})",
+                       regs[XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031],
+                       regs[XE_GPU_REG_SHADER_CONSTANT_BOOL_032_063],
+                       regs.Get<float>(XE_GPU_REG_RB_BLEND_RED),
+                       regs.Get<float>(XE_GPU_REG_RB_BLEND_GREEN),
+                       regs.Get<float>(XE_GPU_REG_RB_BLEND_BLUE),
+                       regs.Get<float>(XE_GPU_REG_RB_BLEND_ALPHA));
+      FrameDumpAddShader(pixel_shader);
+    }
+  }
+  // Every vertex shader of the frame (position math of all geometry, e.g.
+  // the weapon prepass vs. its color pass).
+  FrameDumpAddShader(vertex_shader);
+  t += "\n";
+}
