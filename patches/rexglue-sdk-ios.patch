@@ -0,0 +1,361 @@
+/**
+ * @file        ui/frame_pacing.cpp
+ * @brief       Guest frame pacing locked to the host display
+ *
+ * @license     BSD 3-Clause License
+ */
+
+#include <rex/ui/frame_pacing.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <vector>
+
+#include <fmt/format.h>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/thread.h>
+
+REXCVAR_DEFINE_INT32(frame_pacing, 0, "Display",
+                     "Guest frame pacing locked to the display: 0 off, 1 automatic (120 Hz while "
+                     "the frames keep up, otherwise an even 60), 60 or 120 fixed");
+
+namespace rex::ui::pacing {
+namespace {
+
+constexpr uint64_t kNsPerSecond = 1000000000ull;
+// Until the presenter reports the display: the 120 Hz ProMotion panel.
+constexpr uint64_t kDefaultRefreshNs = kNsPerSecond / 120;
+constexpr uint32_t kSwapSlots = 256;
+// Refreshes between a guest vblank and the display of the frame swapped on
+// it, when frames are shown at a fixed cadence.
+constexpr uint32_t kMinLatencyRefreshes = 2;
+constexpr uint32_t kMaxLatencyRefreshes = 4;
+// Automatic mode.
+constexpr size_t kGpuSamples = 300;
+constexpr double kProbeGpuMs = 9.0;
+constexpr double kLateIntervalMs = 9.6;
+constexpr uint64_t kFirstProbeBackoffNs = 20 * kNsPerSecond;
+constexpr uint64_t kMaxProbeBackoffNs = 300 * kNsPerSecond;
+
+std::atomic<uint64_t> g_refresh_ns{0};
+// A recent display time; presentations happen on vsync, so this anchors the
+// display's vsync grid.
+std::atomic<uint64_t> g_anchor_ns{0};
+std::atomic<uint64_t> g_last_vblank_ns{0};
+std::atomic<uint32_t> g_auto_rate{120};
+std::atomic<uint32_t> g_latency_refreshes{kMinLatencyRefreshes};
+std::atomic<uint32_t> g_swap_counter{0};
+std::atomic<uint64_t> g_swap_vblank_ns[kSwapSlots];
+std::atomic<uint32_t> g_swap_rate[kSwapSlots];
+
+struct Feedback {
+  uint32_t frames = 0;
+  uint32_t misses = 0;
+  uint32_t quiet_frames = 0;
+  uint64_t raised_at_ns = 0;
+  // Since the last log line.
+  uint64_t log_paced = 0;
+  uint64_t log_late = 0;
+  uint64_t log_early = 0;
+  uint64_t log_late_refreshes = 0;
+};
+
+struct AutoState {
+  uint32_t window_frames = 0;
+  uint32_t late_frames = 0;
+  std::vector<float> gpu_ms;
+  size_t gpu_next = 0;
+  bool probing = false;
+  uint64_t next_probe_ns = 0;
+  uint64_t backoff_ns = kFirstProbeBackoffNs;
+  uint32_t switches = 0;
+};
+
+std::mutex g_mutex;
+Feedback g_feedback;
+AutoState g_auto;
+
+int32_t Mode() { return REXCVAR_GET(frame_pacing); }
+
+uint64_t Refresh() {
+  const uint64_t refresh = g_refresh_ns.load(std::memory_order_relaxed);
+  return refresh ? refresh : kDefaultRefreshNs;
+}
+
+// Display refreshes per guest frame (a 60 Hz guest on a 120 Hz display: 2).
+uint64_t RefreshesPerFrame(uint32_t rate, uint64_t refresh_ns) {
+  if (!rate || !refresh_ns) {
+    return 1;
+  }
+  const uint64_t frame_ns = kNsPerSecond / rate;
+  return std::max<uint64_t>(1, (frame_ns + refresh_ns / 2) / refresh_ns);
+}
+
+// First point of the vsync grid (anchor + n * refresh) at or after t.
+uint64_t GridAtOrAfter(uint64_t t, uint64_t anchor, uint64_t refresh) {
+  if (!anchor || !refresh) {
+    return t;
+  }
+  if (t >= anchor) {
+    return anchor + (t - anchor + refresh - 1) / refresh * refresh;
+  }
+  return anchor - (anchor - t) / refresh * refresh;
+}
+
+// Caller holds g_mutex.
+void SwitchAutoRate(uint32_t rate, uint64_t now_ns, const char* reason) {
+  AutoState& a = g_auto;
+  if (g_auto_rate.load(std::memory_order_relaxed) == rate) {
+    return;
+  }
+  g_auto_rate.store(rate, std::memory_order_relaxed);
+  a.window_frames = 0;
+  a.late_frames = 0;
+  a.gpu_ms.clear();
+  a.gpu_next = 0;
+  ++a.switches;
+  g_feedback.frames = 0;
+  g_feedback.misses = 0;
+  (void)now_ns;
+  REXLOG_WARN("Bildtakt: jetzt {} Hz ({})", rate, reason);
+}
+
+}  // namespace
+
+void SetRefreshPeriodNs(uint64_t period_ns) {
+  // Accept 20 to 250 Hz.
+  if (period_ns >= kNsPerSecond / 250 && period_ns <= kNsPerSecond / 20) {
+    g_refresh_ns.store(period_ns, std::memory_order_relaxed);
+  }
+}
+
+uint64_t RefreshPeriodNs() { return g_refresh_ns.load(std::memory_order_relaxed); }
+
+uint32_t GuestFrameRate() {
+  const int32_t mode = Mode();
+  if (mode == 1) {
+    return g_auto_rate.load(std::memory_order_relaxed);
+  }
+  if (mode >= 20 && mode <= 250) {
+    return uint32_t(mode);
+  }
+  return 0;
+}
+
+uint64_t NextGuestVblankNs() {
+  const uint32_t rate = GuestFrameRate();
+  if (!rate) {
+    return 0;
+  }
+  const uint64_t refresh = Refresh();
+  const uint64_t period = RefreshesPerFrame(rate, refresh) * refresh;
+  const uint64_t now = rex::thread::MonotonicNowNs();
+  const uint64_t last = g_last_vblank_ns.load(std::memory_order_relaxed);
+  uint64_t target = last ? last + period : now;
+  if (target + refresh / 2 < now) {
+    // Fell behind (stalled thread, rate change): start again from now rather
+    // than firing a burst of vblanks.
+    target = now;
+  }
+  // Onto the display's vsync grid (nearest point).
+  const uint64_t anchor = g_anchor_ns.load(std::memory_order_relaxed);
+  if (anchor) {
+    target = GridAtOrAfter(target - std::min(target, refresh / 2), anchor, refresh);
+    while (last && target + refresh / 2 < last + period) {
+      target += refresh;
+    }
+  }
+  return target;
+}
+
+void OnGuestVblank(uint64_t vblank_ns) {
+  g_last_vblank_ns.store(vblank_ns, std::memory_order_relaxed);
+}
+
+uint32_t OnGuestSwap() {
+  uint32_t index = g_swap_counter.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (!index) {
+    index = g_swap_counter.fetch_add(1, std::memory_order_relaxed) + 1;
+  }
+  const uint32_t slot = index % kSwapSlots;
+  g_swap_vblank_ns[slot].store(g_last_vblank_ns.load(std::memory_order_relaxed),
+                               std::memory_order_relaxed);
+  g_swap_rate[slot].store(GuestFrameRate(), std::memory_order_release);
+  return index;
+}
+
+uint64_t DesiredPresentNs(uint32_t swap_index) {
+  if (!swap_index) {
+    return 0;
+  }
+  const uint32_t slot = swap_index % kSwapSlots;
+  const uint32_t rate = g_swap_rate[slot].load(std::memory_order_acquire);
+  const uint64_t vblank = g_swap_vblank_ns[slot].load(std::memory_order_relaxed);
+  if (!rate || !vblank) {
+    return 0;
+  }
+  const uint64_t refresh = Refresh();
+  const uint64_t refreshes_per_frame = RefreshesPerFrame(rate, refresh);
+  if (refreshes_per_frame < 2) {
+    // A new frame every refresh: show each one as soon as it's ready.
+    return 0;
+  }
+  if (rex::thread::MonotonicNowNs() > vblank + 2 * refreshes_per_frame * refresh) {
+    // Long past its vblank (loading, stall): don't hold it back further.
+    return 0;
+  }
+  return vblank + g_latency_refreshes.load(std::memory_order_relaxed) * refresh;
+}
+
+void OnPresentationDisplayed(uint64_t actual_ns, uint64_t desired_ns) {
+  if (!actual_ns) {
+    return;
+  }
+  uint64_t anchor = g_anchor_ns.load(std::memory_order_relaxed);
+  while (actual_ns > anchor &&
+         !g_anchor_ns.compare_exchange_weak(anchor, actual_ns, std::memory_order_relaxed)) {
+  }
+  if (!desired_ns) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(g_mutex);
+  Feedback& f = g_feedback;
+  const uint64_t refresh = Refresh();
+  ++f.log_paced;
+  ++f.frames;
+  if (actual_ns > desired_ns + refresh / 2) {
+    ++f.misses;
+    ++f.log_late;
+    f.log_late_refreshes += (actual_ns - desired_ns + refresh / 2) / refresh;
+  } else if (actual_ns + refresh / 2 < desired_ns) {
+    ++f.log_early;
+  }
+  if (f.frames < 120) {
+    return;
+  }
+  uint32_t latency = g_latency_refreshes.load(std::memory_order_relaxed);
+  if (f.misses >= 3 && latency < kMaxLatencyRefreshes) {
+    ++latency;
+    g_latency_refreshes.store(latency, std::memory_order_relaxed);
+    f.raised_at_ns = actual_ns;
+    f.quiet_frames = 0;
+    REXLOG_WARN("Bildtakt: {} von {} Bildern zu spaet, Vorlauf jetzt {} Bildwechsel", f.misses,
+                f.frames, latency);
+  } else if (!f.misses) {
+    f.quiet_frames += f.frames;
+    // A shorter lead after a minute without a late frame, but not within five
+    // minutes of having had to raise it.
+    if (latency > kMinLatencyRefreshes && f.quiet_frames >= 3600 &&
+        actual_ns - f.raised_at_ns > 300 * kNsPerSecond) {
+      --latency;
+      g_latency_refreshes.store(latency, std::memory_order_relaxed);
+      f.quiet_frames = 0;
+      REXLOG_WARN("Bildtakt: Vorlauf jetzt {} Bildwechsel", latency);
+    }
+  } else {
+    f.quiet_frames = 0;
+  }
+  f.frames = 0;
+  f.misses = 0;
+}
+
+void OnFrameFinished(double gpu_ms, double interval_ms) {
+  if (Mode() != 1) {
+    return;
+  }
+  if (!(interval_ms > 0.0) || interval_ms > 250.0) {
+    // First frame, loading screens and pauses say nothing about the load.
+    return;
+  }
+  std::lock_guard<std::mutex> lock(g_mutex);
+  AutoState& a = g_auto;
+  const uint64_t now = rex::thread::MonotonicNowNs();
+  if (g_auto_rate.load(std::memory_order_relaxed) >= 120) {
+    ++a.window_frames;
+    if (interval_ms > kLateIntervalMs) {
+      ++a.late_frames;
+    }
+    if (a.window_frames < 120) {
+      return;
+    }
+    const uint32_t late = a.late_frames;
+    const uint32_t frames = a.window_frames;
+    a.window_frames = 0;
+    a.late_frames = 0;
+    if (a.probing) {
+      a.probing = false;
+      if (late * 20 > frames) {
+        a.backoff_ns = std::min(a.backoff_ns * 2, kMaxProbeBackoffNs);
+        a.next_probe_ns = now + a.backoff_ns;
+        SwitchAutoRate(60, now, fmt::format("120 Hz nicht gehalten, {} von {} Bildern zu spaet",
+                                            late, frames)
+                                    .c_str());
+      } else {
+        a.backoff_ns = kFirstProbeBackoffNs;
+      }
+    } else if (late * 10 > frames) {
+      a.next_probe_ns = now + a.backoff_ns;
+      SwitchAutoRate(
+          60, now,
+          fmt::format("{} von {} Bildern zu spaet fuer 120 Hz", late, frames).c_str());
+    }
+    return;
+  }
+  // At 60 Hz: try 120 Hz again when the GPU has clear headroom.
+  if (gpu_ms > 0.0) {
+    if (a.gpu_ms.size() < kGpuSamples) {
+      a.gpu_ms.push_back(float(gpu_ms));
+    } else {
+      a.gpu_ms[a.gpu_next] = float(gpu_ms);
+      a.gpu_next = (a.gpu_next + 1) % kGpuSamples;
+    }
+  }
+  if (a.gpu_ms.size() < kGpuSamples || now < a.next_probe_ns) {
+    return;
+  }
+  std::vector<float> sorted(a.gpu_ms);
+  std::nth_element(sorted.begin(), sorted.begin() + sorted.size() * 9 / 10, sorted.end());
+  const double p90 = sorted[sorted.size() * 9 / 10];
+  if (p90 < kProbeGpuMs) {
+    a.probing = true;
+    SwitchAutoRate(120, now, fmt::format("GPU {:.1f} ms (p90), Versuch", p90).c_str());
+  } else {
+    a.next_probe_ns = now + 5 * kNsPerSecond;
+  }
+}
+
+std::string StatusText() {
+  const uint32_t rate = GuestFrameRate();
+  if (!rate) {
+    return "aus";
+  }
+  std::string text = fmt::format("{} Hz{}", rate, Mode() == 1 ? " (auto)" : "");
+  if (RefreshesPerFrame(rate, Refresh()) >= 2) {
+    text += fmt::format(", +{}", g_latency_refreshes.load(std::memory_order_relaxed));
+  }
+  return text;
+}
+
+std::string TakeLogText() {
+  const uint32_t rate = GuestFrameRate();
+  std::lock_guard<std::mutex> lock(g_mutex);
+  Feedback& f = g_feedback;
+  std::string text = fmt::format(
+      "Bildtakt {} | Anzeige {:.2f} ms | getaktet {}, zu spaet {} (im Schnitt {:.1f} "
+      "Bildwechsel), zu frueh {} | Wechsel 60/120: {}",
+      rate ? fmt::format("{} Hz{}", rate, Mode() == 1 ? " auto" : "") : std::string("aus"),
+      double(Refresh()) / 1e6, f.log_paced, f.log_late,
