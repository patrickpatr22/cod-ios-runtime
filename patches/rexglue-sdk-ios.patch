+#if defined(__APPLE__)
+uint64_t ThreadCpuNs(const rex::thread::ThreadTimeCounters& counters) {
+  thread_basic_info_data_t info;
+  mach_msg_type_number_t count = THREAD_BASIC_INFO_COUNT;
+  if (thread_info(mach_port_t(counters.mach_port), THREAD_BASIC_INFO,
+                  reinterpret_cast<thread_info_t>(&info), &count) != KERN_SUCCESS) {
+    return 0;
+  }
+  return (uint64_t(info.user_time.seconds) + uint64_t(info.system_time.seconds)) * 1000000000ull +
+         (uint64_t(info.user_time.microseconds) + uint64_t(info.system_time.microseconds)) * 1000ull;
+}
+#else
+uint64_t ThreadCpuNs(const rex::thread::ThreadTimeCounters& counters) {
+  clockid_t clock_id;
+  if (pthread_getcpuclockid(reinterpret_cast<pthread_t>(counters.pthread_handle), &clock_id) != 0) {
+    return 0;
+  }
+  timespec ts = {};
+  if (clock_gettime(clock_id, &ts) != 0) {
+    return 0;
+  }
+  return uint64_t(ts.tv_sec) * 1000000000ull + uint64_t(ts.tv_nsec);
+}
+#endif
+
+// Name of a thread that is known to be alive (pthread_getname_np must not be
+// called for a thread that has ended).
+std::string ThreadName(const rex::thread::ThreadTimeCounters& counters) {
+  std::string name;
+  if (rex::thread::LookupThreadName(counters.pthread_handle, &name) && !name.empty()) {
+    return name;
+  }
+  char buffer[64] = {};
+  if (pthread_getname_np(reinterpret_cast<pthread_t>(counters.pthread_handle), buffer,
+                         sizeof(buffer)) == 0) {
+    return buffer;
+  }
+  return {};
+}
+
+#if defined(__APPLE__)
+// Mach ports of the threads alive right now.
+std::vector<uint32_t> LiveThreadPorts() {
+  std::vector<uint32_t> ports;
+  thread_act_array_t threads = nullptr;
+  mach_msg_type_number_t thread_count = 0;
+  if (task_threads(mach_task_self(), &threads, &thread_count) != KERN_SUCCESS) {
+    return ports;
+  }
+  ports.reserve(thread_count);
+  for (mach_msg_type_number_t i = 0; i < thread_count; ++i) {
+    ports.push_back(uint32_t(threads[i]));
+    mach_port_deallocate(mach_task_self(), threads[i]);
+  }
+  vm_deallocate(mach_task_self(), reinterpret_cast<vm_address_t>(threads),
+                thread_count * sizeof(thread_act_t));
+  std::sort(ports.begin(), ports.end());
+  return ports;
+}
+#endif
+
+int RoleForName(const std::string& name) {
+  auto starts = [&](const char* prefix) { return name.rfind(prefix, 0) == 0; };
+  if (starts("Main XThread")) return kRoleMain;
+  if (starts("Backend")) return kRoleRender;
+  if (starts("JQ Worker")) return kRoleJobs;
+  if (starts("Server")) return kRoleServer;
+  if (starts("GPU Commands")) return kRoleCp;
+  if (name.find("Audio") != std::string::npos || starts("XMA")) return kRoleAudio;
+  return -1;
+}
+
+void RescanThreads(State& s, uint64_t now_ns) {
+  if (now_ns < s.next_rescan_ns) {
+    return;
+  }
+  s.next_rescan_ns = now_ns + 2000000000ull;
+#if defined(__APPLE__)
+  const std::vector<uint32_t> live_ports = LiveThreadPorts();
+  auto is_alive = [&](const rex::thread::ThreadTimeCounters& counters) {
+    return std::binary_search(live_ports.begin(), live_ports.end(), counters.mach_port);
+  };
+#else
+  auto is_alive = [](const rex::thread::ThreadTimeCounters&) { return true; };
+#endif
+  // Threads that ended are dropped (their port name may be reused).
+  s.tracked.erase(std::remove_if(s.tracked.begin(), s.tracked.end(),
+                                 [&](const TrackedThread& t) {
+                                   if (is_alive(*t.counters)) {
+                                     return false;
+                                   }
+                                   s.classified[t.counters] = -2;
+                                   return true;
+                                 }),
+                  s.tracked.end());
+  rex::thread::ForEachThreadTimeCounters([&](rex::thread::ThreadTimeCounters& counters) {
+    auto it = s.classified.find(&counters);
+    if (it != s.classified.end() && (it->second >= 0 || it->second == -2)) {
+      return;
+    }
+    if (!is_alive(counters)) {
+      s.classified[&counters] = -2;
+      return;
+    }
+    const std::string name = ThreadName(counters);
+    const int role = RoleForName(name);
+    // Unnamed or not yet renamed threads are checked again later.
+    s.classified[&counters] = role;
+    if (role >= 0) {
+      TrackedThread& t = s.tracked.emplace_back();
+      t.counters = &counters;
+      t.role = Role(role);
+      t.name = name;
+    }
+  });
+}
+
+// Per-frame time deltas of the tracked threads.
+void SampleThreads(State& s, FrameRecord& f) {
+  for (TrackedThread& t : s.tracked) {
+    const uint64_t cpu = ThreadCpuNs(*t.counters);
+    const uint64_t yield = t.counters->yield_ns.load(std::memory_order_relaxed);
+    const uint64_t wait = t.counters->wait_ns.load(std::memory_order_relaxed);
+    const uint64_t sleep = t.counters->sleep_ns.load(std::memory_order_relaxed);
+    if (t.primed && cpu >= t.last_cpu_ns) {
+      RoleTimes& r = f.roles[t.role];
+      r.cpu_ms += double(cpu - t.last_cpu_ns) * kNsToMs;
+      r.yield_ms += double(yield - t.last_yield_ns) * kNsToMs;
+      r.wait_ms += double(wait - t.last_wait_ns) * kNsToMs;
+      r.sleep_ms += double(sleep - t.last_sleep_ns) * kNsToMs;
+      ++r.threads;
+    }
+    t.primed = cpu != 0;
+    t.last_cpu_ns = cpu;
+    t.last_yield_ns = yield;
+    t.last_wait_ns = wait;
+    t.last_sleep_ns = sleep;
+  }
+}
+
+Limiter Classify(const FrameRecord& f) {
+  if (f.counters.shader_wait) {
+    return kLimShader;
+  }
+  const double interval = std::max(f.interval_ms, 0.1);
+  const std::pair<Limiter, double> candidates[] = {
+      {kLimGpu, f.gpu_ms},
+      {kLimRender, f.roles[kRoleRender].work()},
+      {kLimMain, f.roles[kRoleMain].work()},
+      {kLimCp, f.roles[kRoleCp].work()},
+  };
+  Limiter best = kLimSync;
+  double best_value = 0.0;
+  for (const auto& [limiter, value] : candidates) {
+    if (value > best_value) {
+      best_value = value;
+      best = limiter;
+    }
+  }
+  return best_value >= 0.75 * interval ? best : kLimSync;
+}
+
+std::string Percent(uint32_t part, uint32_t total) {
+  return fmt::format("{:.0f}%", total ? 100.0 * part / total : 0.0);
+}
