@@ -0,0 +1,64 @@
+/**
+ * @file        graphics/vulkan/frame_telemetry.h
+ * @brief       Per-frame performance telemetry of the Vulkan command processor
+ *
+ * For every guest frame: how long it took, how busy the host GPU was, how much
+ * real work (CPU time minus spin-yields) the title's main thread, its render
+ * thread, its job threads and the command processor did, and which of them
+ * limited the frame. Plus when the frames actually reached the display
+ * (VK_GOOGLE_display_timing). Summaries go to the overlay and the log, and
+ * optionally every frame to CSV files for offline analysis.
+ *
+ * All functions except the CSV writer run on the command processor thread.
+ *
+ * @license     BSD 3-Clause License
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace rex::graphics::vulkan::telemetry {
+
+struct SwapCounters {
+  uint32_t draws = 0;
+  uint32_t render_passes = 0;
+  uint32_t upload_breaks = 0;
+  uint32_t texture_load_breaks = 0;
+  uint32_t resolves = 0;
+  uint32_t submissions = 0;
+  uint32_t uploads = 0;
+  uint64_t upload_bytes = 0;
+  uint32_t texture_loads = 0;
+  uint32_t memexport_draws = 0;
+  uint32_t pipelines_created = 0;
+  uint64_t access_violations = 0;
+  uint32_t render_area_passes = 0;
+  uint64_t render_area_permille = 0;
+  double fence_wait_ms = 0.0;
+  bool shader_wait = false;
+  // false if the frame isn't shown (placeholder pipelines, skipped).
+  bool presented = true;
+};
+
+// At each guest swap processed by the command processor. Returns the frame
+// number to tag the presentation with.
+uint64_t OnSwap(const SwapCounters& counters);
+// After the swap's submission: the last submission index of the frame.
+void OnSwapSubmitted(uint64_t frame_index, uint64_t last_submission);
+// GPU busy time of one submission.
+void OnSubmissionGpuTime(uint64_t submission, double ms);
+// All submissions up to this index are complete and their GPU times known.
+void OnCompletedSubmission(uint64_t completed_submission);
+
+// Overlay lines (may be empty).
+std::string OverlayText();
+
+// A/B comparison: the configuration being measured now (empty = none) and
+// whether this part of the phase counts (after the warm-up).
+void SetAbPhase(const std::string& label, bool measuring);
+// One line per configuration measured so far.
+std::string AbReport();
+
+}  // namespace rex::graphics::vulkan::telemetry
diff --git a/src/graphics/vulkan/pipeline_cache.cpp b/src/graphics/vulkan/pipeline_cache.cpp
index 91ac08f..2735aeb 100644
--- a/src/graphics/vulkan/pipeline_cache.cpp
+++ b/src/graphics/vulkan/pipeline_cache.cpp
