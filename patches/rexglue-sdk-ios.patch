+/**
+ * @file        ui/vulkan/moltenvk_config.h
+ * @brief       MoltenVK settings applied through its private API, and its
+ *              performance statistics
+ *
+ * MoltenVK reads MVK_CONFIG_* environment variables, but only when its
+ * global configuration is first used, and apps on iOS can't rely on when
+ * that happens. The settings are therefore set explicitly through
+ * vkSetMoltenVKConfigurationMVK before the instance is created, and the
+ * values that were in effect are logged.
+ *
+ * @license     BSD 3-Clause License
+ */
+
+#pragma once
+
+#include <string>
+
+#include <rex/platform/dynlib.h>
+#include <rex/ui/vulkan/api.h>
+
+namespace rex::ui::vulkan {
+
+// Applies the mvk_* cvars to MoltenVK if `library` is MoltenVK (no-op for
+// other Vulkan implementations). Call before vkCreateInstance.
+void ConfigureMoltenVK(const rex::platform::DynamicLibrary& library);
+
+// Queue performance of MoltenVK since the previous call (empty if MoltenVK's
+// performance tracking is off or unavailable).
+std::string TakeMoltenVKPerformanceText(VkDevice device);
+
+}  // namespace rex::ui::vulkan
