+bool DeferredCommandBuffer::PatchBeginRenderArea(size_t command_position,
+                                                 const VkRect2D& render_area) {
+  if (command_position + kCommandHeaderSizeElements > command_stream_.size()) {
+    return false;
+  }
+  const CommandHeader& header =
+      *reinterpret_cast<const CommandHeader*>(command_stream_.data() + command_position);
+  uintmax_t* args = command_stream_.data() + command_position + kCommandHeaderSizeElements;
+  switch (header.command) {
+    case Command::kVkBeginRenderPass:
+      reinterpret_cast<ArgsVkBeginRenderPass*>(args)->render_area = render_area;
+      return true;
+    case Command::kVkBeginRendering:
+      reinterpret_cast<ArgsVkBeginRendering*>(args)->render_area = render_area;
+      return true;
+    default:
+      return false;
+  }
+}
