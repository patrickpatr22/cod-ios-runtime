+uint32_t TextureCache::Texture::AuditIfDue(const std::unique_lock<std::recursive_mutex>& global_lock,
+                                           uint64_t current_submission,
+                                           uint64_t interval_submissions) {
+  if (audit_submission_ + interval_submissions > current_submission) {
+    return 0;
+  }
+  audit_submission_ = current_submission;
+  if (key().scaled_resolve) {
+    return 0;
+  }
+  SharedMemory& shared_memory = texture_cache().shared_memory();
+  uint32_t hashed_bytes = 0;
+  // Returns whether the part's guest bytes differ from the ones it was loaded
+  // from while the texture still considers itself up to date.
+  auto check_part = [&](bool outdated, bool& valid, uint64_t hash, uint32_t address,
+                        uint32_t size) {
+    if (outdated || !valid) {
+      return false;
+    }
+    const uint32_t length = GetHashedGuestRangeLength(address, size);
+    if (shared_memory.IsRangeGpuWrittenLocked(address, length)) {
+      // Resolved by the GPU since - the guest bytes don't describe the data.
+      valid = false;
+      return false;
+    }
+    hashed_bytes += length;
+    return XXH3_64bits(shared_memory.guest_memory().TranslatePhysical(address), length) != hash;
+  };
+  const uint32_t base_address = key().base_page << 12;
+  const uint32_t mips_address = key().mip_page << 12;
+  // The GPU copy of the pages may be older than the guest data even if the
+  // guest data hasn't changed since the load (a write the notifications
+  // missed before the load). That invalidates the pages and, through the
+  // watches, this texture.
+  if (!base_outdated_ && key().base_page) {
+    hashed_bytes += GetGuestBaseSize();
+    shared_memory.VerifyUploadedRange(base_address, GetGuestBaseSize());
+  }
+  if (!mips_outdated_ && key().mip_page) {
+    hashed_bytes += GetGuestMipsSize();
+    shared_memory.VerifyUploadedRange(mips_address, GetGuestMipsSize());
+  }
+  const bool base_stale = check_part(base_outdated_, audit_base_valid_, audit_base_hash_,
+                                     base_address, GetGuestBaseSize());
+  const bool mips_stale = check_part(mips_outdated_, audit_mips_valid_, audit_mips_hash_,
+                                     mips_address, GetGuestMipsSize());
