+  t.acquire_ns += sample.acquire_ns;
+  t.await_ns += sample.await_ns;
+  t.consume_ns += sample.consume_ns;
+  t.ui_ns += sample.ui_ns;
+  t.queue_lock_ns += sample.queue_lock_ns;
+  t.submit_ns += sample.submit_ns;
+  t.present_ns += sample.present_ns;
+  t.cpu_ns += sample.cpu_ns;
