+void VulkanPipelineCache::InitializePersistentPipelineCache(const std::filesystem::path& path) {
+  ShutdownPersistentPipelineCache();
+  if (!REXCVAR_GET(vulkan_persistent_pipeline_cache)) {
+    // Don't leave hundreds of megabytes of an earlier cache behind.
+    std::error_code ec;
+    if (std::filesystem::remove(path, ec)) {
+      REXGPU_WARN("Persistent pipeline cache disabled, removed {}", path.filename().string());
+    }
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = command_processor_.GetVulkanDevice();
+  const VkDevice device = vulkan_device->device();
+  const auto get_device_proc_addr = vulkan_device->vulkan_instance()->functions().vkGetDeviceProcAddr;
+  auto create = reinterpret_cast<PFN_vkCreatePipelineCache>(
+      get_device_proc_addr(device, "vkCreatePipelineCache"));
+  auto get_data = reinterpret_cast<PFN_vkGetPipelineCacheData>(
+      get_device_proc_addr(device, "vkGetPipelineCacheData"));
+  auto destroy = reinterpret_cast<PFN_vkDestroyPipelineCache>(
+      get_device_proc_addr(device, "vkDestroyPipelineCache"));
+  if (!create || !get_data || !destroy) {
+    return;
+  }
+  std::vector<char> initial_data;
+  if (FILE* file = rex::filesystem::OpenFile(path, "rb")) {
+    rex::filesystem::Seek(file, 0, SEEK_END);
+    const int64_t size = rex::filesystem::Tell(file);
+    rex::filesystem::Seek(file, 0, SEEK_SET);
+    if (size > 0 && size < (int64_t(1) << 30)) {
+      initial_data.resize(size_t(size));
+      initial_data.resize(fread(initial_data.data(), 1, initial_data.size(), file));
+    }
+    fclose(file);
+  }
+  VkPipelineCacheCreateInfo create_info = {};
+  create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+  create_info.initialDataSize = initial_data.size();
+  create_info.pInitialData = initial_data.empty() ? nullptr : initial_data.data();
+  VkPipelineCache cache = VK_NULL_HANDLE;
+  VkResult result = create(device, &create_info, nullptr, &cache);
+  if (result != VK_SUCCESS && !initial_data.empty()) {
+    // Stale or damaged (other MoltenVK version or device) - start empty.
+    initial_data.clear();
+    create_info.initialDataSize = 0;
+    create_info.pInitialData = nullptr;
+    result = create(device, &create_info, nullptr, &cache);
+  }
+  if (result != VK_SUCCESS) {
+    REXGPU_WARN("Persistent pipeline cache unavailable ({})", int32_t(result));
+    return;
+  }
+  persistent_pipeline_cache_ = cache;
+  persistent_pipeline_cache_path_ = path;
+  persistent_pipeline_cache_get_data_ = get_data;
+  persistent_pipeline_cache_destroy_ = destroy;
+  persistent_pipeline_cache_saved_size_ = initial_data.size();
+  persistent_pipelines_since_save_.store(0, std::memory_order_relaxed);
+  REXGPU_WARN("Persistent pipeline cache: {} KB loaded", initial_data.size() / 1024);
+}
+
+void VulkanPipelineCache::NotePersistentPipelineCreated() {
+  if (persistent_pipeline_cache_ == VK_NULL_HANDLE) {
+    return;
+  }
+  // Every 32 new pipelines. While the storage is being loaded at startup the
+  // write thread doesn't exist yet, it saves once when it starts.
+  if (persistent_pipelines_since_save_.fetch_add(1, std::memory_order_relaxed) + 1 < 32) {
+    return;
+  }
+  // The cache holds the MSL of every pipeline (hundreds of MB), so write it
+  // at most every two minutes.
+  static std::atomic<int64_t> last_save_request_seconds{0};
+  const int64_t now_seconds = std::chrono::duration_cast<std::chrono::seconds>(
+                                  std::chrono::steady_clock::now().time_since_epoch())
+                                  .count();
+  if (now_seconds - last_save_request_seconds.load(std::memory_order_relaxed) < 120) {
+    return;
+  }
+  {
+    std::lock_guard<std::mutex> lock(storage_write_request_lock_);
+    if (!storage_write_thread_) {
+      return;
+    }
+    last_save_request_seconds.store(now_seconds, std::memory_order_relaxed);
+    persistent_pipelines_since_save_.store(0, std::memory_order_relaxed);
+    storage_write_save_vk_pipeline_cache_ = true;
+  }
+  storage_write_request_cond_.notify_one();
+}
+
+void VulkanPipelineCache::SavePersistentPipelineCache() {
+  if (persistent_pipeline_cache_ == VK_NULL_HANDLE) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(persistent_pipeline_cache_save_mutex_);
+  const VkDevice device = command_processor_.GetVulkanDevice()->device();
+  size_t size = 0;
+  if (persistent_pipeline_cache_get_data_(device, persistent_pipeline_cache_, &size, nullptr) !=
+          VK_SUCCESS ||
+      !size || size == persistent_pipeline_cache_saved_size_) {
+    return;
+  }
+  std::vector<char> data(size);
+  if (persistent_pipeline_cache_get_data_(device, persistent_pipeline_cache_, &size,
+                                          data.data()) != VK_SUCCESS) {
+    return;
+  }
+  // Write and then rename, so being killed mid-write never leaves a cut file.
+  std::filesystem::path temp_path = persistent_pipeline_cache_path_;
+  temp_path += ".tmp";
+  FILE* file = rex::filesystem::OpenFile(temp_path, "wb");
+  if (!file) {
+    return;
+  }
+  const bool written = fwrite(data.data(), 1, size, file) == size;
+  fclose(file);
+  std::error_code ec;
+  if (!written) {
+    std::filesystem::remove(temp_path, ec);
+    return;
+  }
+  std::filesystem::rename(temp_path, persistent_pipeline_cache_path_, ec);
+  if (!ec) {
+    persistent_pipeline_cache_saved_size_ = size;
+  }
+}
+
+void VulkanPipelineCache::ShutdownPersistentPipelineCache() {
+  if (persistent_pipeline_cache_ == VK_NULL_HANDLE) {
+    return;
+  }
+  SavePersistentPipelineCache();
+  persistent_pipeline_cache_destroy_(command_processor_.GetVulkanDevice()->device(),
+                                     persistent_pipeline_cache_, nullptr);
+  persistent_pipeline_cache_ = VK_NULL_HANDLE;
+}
