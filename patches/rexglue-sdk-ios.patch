+struct PerfWindow {
+  std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+  uint32_t swaps = 0;
+  uint32_t shader_wait_frames = 0;
+  uint32_t draws = 0;
+  uint32_t render_passes = 0;
+  uint32_t submissions = 0;
+  uint32_t copies = 0;
+  uint32_t pipelines_created = 0;
+  uint32_t texture_loads = 0;
+  uint64_t access_violations = 0;
+  uint32_t texture_load_breaks = 0;
+  uint32_t texture_revalidations = 0;
+  uint32_t uploads = 0;
+  uint32_t upload_breaks = 0;
+  uint32_t uploads_hoisted = 0;
+  uint32_t upload_breaks_declared = 0;
+  uint64_t upload_bytes = 0;
+  uint32_t memexport_draws = 0;
+  uint32_t memexport_unknown = 0;
+  uint32_t render_area_passes = 0;
+  uint64_t render_area_permille = 0;
+  // Frames longer than 100 ms (visible hitches).
+  uint32_t hitches = 0;
+  double gpu_time_ms = 0.0;
+  double worst_frame_ms = 0.0;
+  double fence_wait_ms = 0.0;
+
+  void Add(const PerfWindow& frame) {
+    swaps += frame.swaps;
+    shader_wait_frames += frame.shader_wait_frames;
+    draws += frame.draws;
+    render_passes += frame.render_passes;
+    submissions += frame.submissions;
+    copies += frame.copies;
+    pipelines_created += frame.pipelines_created;
+    texture_loads += frame.texture_loads;
+    access_violations += frame.access_violations;
+    texture_load_breaks += frame.texture_load_breaks;
+    texture_revalidations += frame.texture_revalidations;
+    uploads += frame.uploads;
+    upload_breaks += frame.upload_breaks;
+    uploads_hoisted += frame.uploads_hoisted;
+    upload_breaks_declared += frame.upload_breaks_declared;
+    upload_bytes += frame.upload_bytes;
+    memexport_draws += frame.memexport_draws;
+    memexport_unknown += frame.memexport_unknown;
+    render_area_passes += frame.render_area_passes;
+    render_area_permille += frame.render_area_permille;
+    hitches += frame.hitches;
+    gpu_time_ms += frame.gpu_time_ms;
+    worst_frame_ms = std::max(worst_frame_ms, frame.worst_frame_ms);
+    fence_wait_ms += frame.fence_wait_ms;
+  }
+
+  double AreaPercent() const {
+    return render_area_passes ? double(render_area_permille) / (10.0 * render_area_passes)
+                              : 100.0;
+  }
+
+  std::string Format(double seconds, bool fsi) const {
+    const double frames = std::max(double(swaps), 1.0);
+    return fmt::format(
+        "FPS {:.1f} | Frame {:.0f} ms (max {:.0f}) | GPU-Zeit {:.1f} ms | GPU-Wait {:.0f}% | "
+        "Shader-Wait {}/{} | Haenger {}\n"
+        "Draws {:.0f} | Passes {:.0f} (Upload {:.0f}, TexLoad {:.0f}) | Flaeche {:.0f}% | "
+        "Resolves {:.0f} | Submits {:.1f}\n"
+        "Uploads {:.0f} ({:.0f} KB, vorgezogen {:.0f}, im Pass {:.0f} davon nur Vertex-Bereich "
+        "{:.0f}) | Tex-Loads {:.0f} (+{:.0f} gespart) | Pipelines +{} | "
+        "Faults {:.0f} | Memexport {:.1f} | Pfad {}",
+        swaps / seconds, 1000.0 * seconds / frames, worst_frame_ms, gpu_time_ms / frames,
+        fence_wait_ms / (10.0 * seconds), shader_wait_frames, swaps, hitches, draws / frames,
+        render_passes / frames, upload_breaks / frames, texture_load_breaks / frames,
+        AreaPercent(), copies / frames, submissions / frames, uploads / frames,
+        double(upload_bytes) / 1024.0 / frames, uploads_hoisted / frames, upload_breaks / frames,
+        upload_breaks_declared / frames, texture_loads / frames,
+        texture_revalidations / frames, pipelines_created, access_violations / frames,
+        memexport_draws / frames, fsi ? "fsi" : "fbo");
+  }
+};
